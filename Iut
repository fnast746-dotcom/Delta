	local function cue(name) -- son facultatif, seulement si TU as mis un ID dans CONFIG.SOUNDS
		local id = name and CONFIG.SOUNDS[name]
		if type(id) ~= 'string' or id == '' then return end
		local s = new('Sound', {SoundId = id, Volume = .8}, fxGui) -- fxGui n'est jamais désactivé
		s.Ended:Connect(function() s:Destroy() end)
		s:Play()
		task.delay(30, function() if s.Parent then s:Destroy() end end)
	end
	local function flash(color, dur, peak) S.flash = {t0 = os.clock(), dur = dur / S.speed, color = color, peak = peak or .85} end
	local function shake(amp, dur)
		if os.clock() > S.shakeEnd then S.shakeAmp = 0 end
		S.shakeAmp = math.max(S.shakeAmp, amp)
		S.shakeEnd = math.max(S.shakeEnd, os.clock() + dur / S.speed)
	end
	local function shakeOffset()
		local now = os.clock()
		if now > S.shakeEnd or S.shakeAmp <= 0 then return CFrame.identity end
		local k = S.shakeAmp * span(S.shakeEnd - now, 0, .4)
		local t = now * 31
		return CFrame.Angles(math.noise(t, 1.3) * k * .05, math.noise(t, 7.1) * k * .05, math.noise(t, 4.2) * k * .03)
	end
