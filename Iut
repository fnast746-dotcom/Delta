		-- SS-07 HELIOS : attaque inventée pour la V5, même grammaire que les films du mod (sceau au
		-- sol, ascension, machine cosmique, voyage, frappe à la seconde près).
		local function buildSunHD(st, pos, r, seed) -- granulation, taches, chromosphère, couronne, protubérances
			local rng = Random.new(seed or 3)
			local m = new('Model', {Name = 'SunHD'}, st)
			ball(pos, r * 2, C(255, 210, 120), m)
			for i = 1, Q(110, 55) do
				local v = V(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
				if v.Magnitude > .05 then
					ball(pos + v.Unit * r * .99, r * rng:NextNumber(.14, .3), C(255, rng:NextInteger(150, 238),
						rng:NextInteger(40, 130)), m)
				end
			end
			for i = 1, 3 do
				local v = V(rng:NextNumber(-.5, .5), rng:NextNumber(-.4, .4), 1).Unit
				ball(pos + v * r * .995, r * rng:NextNumber(.07, .13), C(80, 30, 10), m, Enum.Material.SmoothPlastic)
			end
			ball(pos, r * 2.1, C(255, 140, 50), m, Enum.Material.Neon, .64)
			ball(pos, r * 2.6, C(255, 168, 80), m, Enum.Material.Neon, .86)
			ball(pos, r * 3.6, C(255, 190, 110), m, Enum.Material.Neon, .94)
			for k = 1, 5 do -- protubérances en arche
				local a = rng:NextNumber(0, TAU)
				local axis = V(math.cos(a), rng:NextNumber(-.6, .6), math.sin(a)).Unit
				local side = axis:Cross(Vector3.yAxis)
				side = side.Magnitude > .1 and side.Unit or Vector3.xAxis
				local h, prev = r * rng:NextNumber(.3, .65), nil
				for j = 0, 12 do
					local t = j / 12
					local q = pos + (axis + side * (t - .5) * .9).Unit * (r + h * math.sin(t * math.pi))
					if prev then line(prev, q, r * .05 * (1.2 - math.abs(t - .5)), C(255, 112, 40), m) end
					prev = q
				end
			end
			return m
		end

