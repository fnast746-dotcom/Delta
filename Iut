			banner(id, 'SS-15 · TOTALITY', col, ctx.strike - t)
		end) then return end
		-- La couronne s'abat : elle descend du ciel et s'écrase en anneau de feu
		countdownHide()
		cue('eclipse_fall')
		local from = ePos + viewDir * 9 * sz
		if not tween(id, .35, function(u)
			local k = easeIn(u)
			coronaFrame(from:Lerp(p + V(0, 1, 0), k), lerp(SR * 1.08, R * 1.6, k), k)
			icam(id, look(camD, p:Lerp(from, .3 * (1 - k))), 78)
		end) then return end
		cue('eclipse_impact')
		for _, s in ipairs(streamers) do s:Destroy() end
		if board then board:Destroy() end
		for _, e in ipairs(sh:GetChildren()) do if e:IsA('ParticleEmitter') then e.Rate = 0 end end
		umbraG:Destroy()
		smoke.Rate = 0
		flash(C(255, 236, 200), 1, 1)
		FX.impact(p, col, sz * 2, {dome = false, frame = C(255, 244, 220), debrisColor = C(60, 40, 30), hot = GOLD})
		VFX.flip(p + V(0, 1, 0), 'sun_wheel', WHITE, R * 5.2, 1.4, {flat = true})
		VFX.flip(p + V(0, 1.2, 0), 'ring_fire', WHITE, R * 6, 1.2, {flat = true})
		FX.shock(p, GOLD, R * 4.4, 1.2, 2 * sz)
		shake(2.2, 1.8)
		caption('La couronne s’abat en anneau de feu ; la lumière revient')
		tele('CORONA · GROUND CONTACT\n1 000 000 °C')
		local fireRing = ring(p + V(0, .25, 0), R * 1.6, C(255, 150, 60), effects, Q(64, 40), 1.6 * sz, nil, Enum.Material.Neon, 0)
		for k = 1, Q(12, 7) do
			local a = k / Q(12, 7) * TAU
			VFX.flip(p + V(math.cos(a) * R * 1.6, 5 * sz, math.sin(a) * R * 1.6), 'fire_wall', WHITE, 14 * sz, 1.4,
				{rot = 0, worldUp = true})
		end
		local fireH = {}
		for k = 1, 4 do
			local a = k / 4 * TAU + .4
			fireH[k] = anchorAt(p + V(math.cos(a) * R * 1.6, 1, math.sin(a) * R * 1.6))
			FX.emitter(fireH[k], 'fire', ColorSequence.new(C(255, 220, 140), C(255, 80, 20)), {rate = Q(30, 14), life = 1.2,
				speed = 6, size = 4 * sz, size1 = 1, drag = 2, accel = V(0, 8, 0), spread = Vector2.new(40, 40), brightness = 3})
		end
		local burnt = disc(p + V(0, .1, 0), R * 2.9, .12, C(14, 10, 10), effects, Enum.Material.SmoothPlastic)
		FX.pulse({bright = .22, bloom = .8, size = 20, tint = C(255, 236, 210)}, .6, .4, 1.6)
		local camO = AX.spinner()
		if not tween(id, 2.8, function(u, e)
			local a = 2.2 + camO.step(.55)
			local dir = ctx.right * math.cos(a) - ctx.fwd * math.sin(a)
			icam(id, look(p + dir * R * 2.6 + V(0, R * (.35 + .2 * e), 0), p + V(0, 2 * sz, 0)), 70)
			moon.Position = moonTo:Lerp(moonTo - ctx.right * SR * 3, e)
			sun.Transparency = e
			moon.Transparency = e
			for _, s in ipairs(stars) do s.Transparency = .15 + .85 * e end
		end) then return end
		for _, s in ipairs(stars) do s:Destroy() end
		sun:Destroy()
		moon:Destroy()
		ringKill(corona)
		-- Restes : anneau de braises qui refroidit, ombre brûlée cerclée d'or, un grain de Baily qui scintille
		cue('eclipse_after')
		caption('Il reste une ombre brûlée, cerclée d’un anneau de braises')
		tele('BURN SCAR · Ø ' .. math.floor(R * 3.2 + .5) .. ' STUDS\nEMBERS · COOLING')
		local bead = ball(p + ctx.right * R * 1.6 + V(0, 1, 0), 1.6 * sz, WHITE, effects)
		local beadL = light(bead, GOLD, 16, 2)
		local t2 = os.clock()
		addAmbient(function(t)
			local k = math.min(1, (t - t2) / 8)
			local c = C(255, 150, 60):Lerp(C(90, 20, 10), k)
			for i, s in ipairs(fireRing.parts) do s.Color = c:Lerp(C(255, 200, 120), (math.sin(t * 3 + i) > .8) and .5 * (1 - k) or 0) end
			for _, h in ipairs(fireH) do
				local e = h:FindFirstChildOfClass('ParticleEmitter')
				if e then e.Rate = Q(30, 14) * (1 - k) end
			end
			local b = math.sin(t * 2.2) > .7 and 1 or 0
			bead.Transparency = 1 - b
			beadL.Brightness = 3 * b
			markSet(1, t)
		end)
	end

	ATTACKS[15] = function(id, ctx) -- SS-16 QUASAR
		local p, sz = ctx.pos, ctx.size
		local col, R = C(255, 110, 220), 26 * sz
		local HOT, MOLT = C(255, 215, 245), C(255, 120, 70)
		if not remoteArm(id, 'star_arm', 'star_press') then return end
		if not waitUntil(id, at(ctx, .8)) then return end
		cue('quasar_mark')
		-- Marque : réticule (anneau en tirets qui tourne, croix, 8 crans), point central
		local g = p + V(0, .14, 0)
		local inner = ring(g, 5 * sz, col, effects, 32, .3)
		local outer = ring(g, 21 * sz, col, effects, Q(56, 40), .2, nil, Enum.Material.Neon, .35)
		local dashes = {}
		for k = 1, 16 do dashes[k] = line(g, g + V(1, 0, 0), .32 * sz, HOT) end
		local cross = {}
		for k = 0, 3 do
			local d = V(math.cos(k * math.pi / 2), 0, math.sin(k * math.pi / 2))
			cross[#cross + 1] = line(g + d * 7 * sz, g + d * 24 * sz, .26 * sz, col)
		end
		local ticks = {}
		for k = 1, 8 do ticks[k] = line(g, g + V(1, 0, 0), .5 * sz, WHITE) end
		local dot = ball(g, 1.4 * sz, WHITE, effects)
		burnText(p, 26 * sz, {'QUASAR', 'SS-16 · GAMMA LOCK', '3C 273'}, col, .35)
		local holder = anchorAt(p + V(0, 1, 0))
		local hl = light(holder, col, 26, 1.5)
		local spin = AX.spinner()
		local function reticle(rate, k) -- k : 0..1 verrouillage (le réticule se resserre)
			local a = spin.step(rate)
			local rr = (14 - 4 * k) * sz
			for i, s in ipairs(dashes) do
				local a0 = a + i / 16 * TAU
				local p0 = g + V(math.cos(a0), 0, math.sin(a0)) * rr
				local p1 = g + V(math.cos(a0 + .22), 0, math.sin(a0 + .22)) * rr
				s.Size = V(s.Size.X, s.Size.Y, (p1 - p0).Magnitude)
				s.CFrame = look((p0 + p1) / 2 + V(0, .03, 0), p1 + V(0, .03, 0))
			end
			for i, s in ipairs(ticks) do
				local a0 = -a * 1.5 + i / 8 * TAU
				local d = V(math.cos(a0), 0, math.sin(a0))
				local p0, p1 = g + d * (rr + 2 * sz), g + d * (rr + 4.5 * sz)
				s.Size = V(s.Size.X, s.Size.Y, (p1 - p0).Magnitude)
				s.CFrame = look((p0 + p1) / 2 + V(0, .05, 0), p1 + V(0, .05, 0))
			end
			dot.Transparency = math.sin(os.clock() * 8) > 0 and 0 or .6
		end
		-- Laser de visée : il descend du ciel sur la cible et s'intensifie
		local skyTop = p + V(0, 600 * sz, 0)
		local lockH = anchorAt(p + V(0, 1, 0))
		local laser = new('Beam', {Attachment0 = attach(lockH, skyTop), Attachment1 = attach(lockH, p + V(0, .3, 0)),
			Color = ColorSequence.new(HOT, col), Width0 = .4, Width1 = .25, LightEmission = 1, LightInfluence = 0, Brightness = 3,
			FaceCamera = true, Segments = 1, Transparency = NumberSequence.new(1)}, lockH)
		local laserGlow = new('Beam', {Attachment0 = laser.Attachment0, Attachment1 = laser.Attachment1, Color = ColorSequence.new(col),
			Width0 = 2, Width1 = 1.2, LightEmission = 1, LightInfluence = 0, Brightness = 2, FaceCamera = true, Segments = 1,
			Texture = VFX.id.ray_glow, TextureMode = Enum.TextureMode.Stretch, Transparency = NumberSequence.new(1)}, lockH)
		local laserOn = at(ctx, 1.6)
		local chargeAt = ctx.strike - 4 / S.speed
		local nextArc = at(ctx, 6)
		if not waitUntil(id, chargeAt, function()
			local t = os.clock()
			local k = span(t, laserOn, chargeAt)
			reticle(.8 + 1.4 * k, k)
			local vis = span(t, laserOn, laserOn + .6 / S.speed)
			local flick = .5 + .5 * math.sin(t * 22)
			laser.Transparency = NumberSequence.new(1 - vis * (.55 + .3 * flick))
			laserGlow.Transparency = NumberSequence.new(1 - vis * (.25 + .2 * flick))
			laser.Width0, laser.Width1 = .4 + 1.2 * k, .25 + .8 * k
			laserGlow.Width0, laserGlow.Width1 = 2 + 4 * k, 1.2 + 3 * k
			if t >= nextArc then -- arcs qui crépitent autour du réticule
				nextArc = t + (.45 - .25 * k) / S.speed
				local a = math.random() * TAU
				local q = g + V(math.cos(a), 0, math.sin(a)) * (12 - 4 * k) * sz
				AX.bolt(q + V(0, .3, 0), g + V(0, 1 + math.random() * 2, 0), col, .16 * sz, .22)
			end
			banner(id, 'SS-16 · GAMMA LOCK', col, ctx.strike - t, string.format('   %d %%', math.floor(k * 100)))
		end) then return end
		-- Charge : le ciel vire au magenta, une sphère de lumière se forme en haut du laser
		cue('quasar_charge')
		caption('Le ciel vire au magenta : la charge se forme au-dessus de la cible')
