	function VFX.gui(parent, name, size, pos, dur, loop, color, alpha) -- animation 2D par-dessus les films
		local id = VFX.id[name]
		if not (id and parent) then return nil end
		local grid = VFX.FLIP[name]
		local img = new('ImageLabel', {AnchorPoint = Vector2.new(.5, .5), Position = pos or UDim2.fromScale(.5, .5),
			Size = size, BackgroundTransparency = 1, Image = id, ImageColor3 = color or WHITE, ImageTransparency = alpha or 0,
			ZIndex = 3}, parent)
		if name ~= 'hyperspeed' then new('UIAspectRatioConstraint', {AspectRatio = 1}, img) end
		if grid then
			local cell = 1024 / grid
			img.ImageRectSize = Vector2.new(cell, cell)
			local n = grid * grid
			FX.anim(dur, function(u)
				local k = loop and (math.floor(u * dur * 15) % n) or math.min(n - 1, math.floor(u * n))
				img.ImageRectOffset = Vector2.new((k % grid) * cell, math.floor(k / grid) * cell)
				if u >= 1 then img:Destroy() end
			end)
		else
			FX.anim(dur, function(u) if u >= 1 then img:Destroy() end end)
		end
		return img
	end
	function VFX.impact(pos, color, s, scorch) -- couches du pack ajoutées à chaque impact
		if VFX.count == 0 then return end
		local cold = color.B > color.R
		VFX.flip(pos + V(0, 6 * s, 0), math.random() < .5 and 'boom1' or 'boom2', WHITE, 38 * s, 1.1, {z = 2})
		VFX.flip(pos + V(0, 3 * s, 0), 'hit', color:Lerp(WHITE, .4), 34 * s, .5, {z = 3})
		VFX.flip(pos + V(0, 2 * s, 0), 'streaks', WHITE, 48 * s, .45, {z = 3})
		VFX.flip(pos + V(0, .6, 0), cold and 'ring_electric' or 'ring_fire', WHITE, 80 * s, .9, {flat = true, z = 1})
		VFX.smoke(pos + V(0, 2 * s, 0), C(105, 96, 90), 14 * s, Q(16, 12), 30 * s)
		if cold then VFX.zap(pos + V(0, 4 * s, 0), color, 14 * s, Q(8, 4)) end
		if scorch ~= false then VFX.cracks(pos, 18 * s) end
	end

