		end) then return end
		cue('bh_open')
		caption('L’horizon s’ouvre au-dessus de la cible')
		local skyPos = p + V(0, 110 * sz, 0)
		ctx.skyFocus = skyPos
		local core = ball(skyPos, 1, BLACK, effects, Enum.Material.SmoothPlastic)
		local disk = {}
		for k = 1, 3 do
			disk[k] = ringNew(effects, Q(64, 40), C(255, 200 - k * 40, 80 - k * 20), Enum.Material.Neon, 2.6 * sz, .6 * sz)
		end
		local lens = ringNew(effects, Q(56, 36), C(255, 240, 220), Enum.Material.Neon, .7 * sz, .7 * sz)
		local sh = anchorAt(skyPos)
		VFX.attach(sh, 'black_hole', col, 90 * sz, 2.4, 1.2, {loop = true, emission = .6})
		VFX.attach(sh, 'dark_smoke', C(28, 20, 30), 70 * sz, 3, 1, {emission = 0, t0 = .45})
		light(sh, col, 60, 4)
		FX.pulse({bright = -.3, sat = -.35, contrast = .25, vig = .35, tint = C(255, 228, 210)}, 2, 3.4, .6)
		local rocks = {}
		for k = 1, Q(22, 12) do
			local a, r0 = math.random() * TAU, R * (.5 + math.random() * 1.2)
			rocks[k] = {p = AX.rock(p + V(math.cos(a) * r0, .6, math.sin(a) * r0), (1 + math.random() * 1.6) * sz),
				a = a, r0 = r0, d = math.random() * .5, spin = V(math.random(), math.random(), math.random()) * 6}
		end
		VFX.cracks(p, R * .9)
		if not tween(id, 5.5, function(u)
			local t = os.clock()
			spiral(spin.step(1.2 + 8 * u))
			local d = 30 * sz * easeOut(math.min(1, u * 1.6))
			core.Size = V(d, d, d)
			for k, r in ipairs(disk) do ringSet(r, skyPos, math.max(.5, d * (.75 + k * .28)), CFrame.Angles(.28, t * (3 - k * .6), .1)) end
			AX.faceRing(lens, skyPos, math.max(.5, d * .56))
			for _, rk in ipairs(rocks) do
				if rk.p.Parent then
					local k2 = easeIn(span(u, rk.d, 1))
