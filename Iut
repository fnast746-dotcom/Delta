		-- Ville de boîtes bleues (film et monde) : corps sombre + liseré néon sur le dessus.
		local function buildCity(parent, center, n, cell, hmin, hmax, clear, seed)
			local rng, boxes = Random.new(seed), {}
			for x = -n, n do
				for z = -n, n do
					if math.max(math.abs(x), math.abs(z)) > clear then
						local h, w = rng:NextNumber(hmin, hmax), cell * rng:NextNumber(.62, .8)
						local base = center + V(x * cell, 0, z * cell)
						boxes[#boxes + 1] = {base = base, h = h, w = w,
							body = part(V(w, h, w), CF(base + V(0, h / 2, 0)), C(8, 14, 30), parent, Enum.Material.SmoothPlastic),
							cap = part(V(w + .3, .25, w + .3), CF(base + V(0, h + .05, 0)), C(70, 160, 255), parent, Enum.Material.Neon),
							top = part(V(w - .3, .3, w - .3), CF(base + V(0, h + .12, 0)), C(10, 18, 40), parent, Enum.Material.SmoothPlastic)}
					end
				end
			end
			return boxes
		end
		local function boxHeight(b, h)
			h = math.max(.2, h)
			b.body.Size = V(b.w, h, b.w)
			b.body.CFrame = CF(b.base + V(0, h / 2, 0))
			b.cap.CFrame = CF(b.base + V(0, h + .05, 0))
			b.top.CFrame = CF(b.base + V(0, h + .12, 0))
		end

