	function FX.impactFrame(color) -- image d'impact : blanc pur, négatif bref, puis lueur colorée
		local t0 = os.clock()
		FX.anim(.34, function(u)
			local age = (os.clock() - t0) * S.speed
			local f = FX.ifr
			if age < .045 then
				f.BackgroundColor3, f.BackgroundTransparency = WHITE, 0
			elseif age < .095 then
				f.BackgroundColor3, f.BackgroundTransparency = BLACK, .3
			else
				f.BackgroundColor3 = color or WHITE
				f.BackgroundTransparency = .4 + .6 * span(u, .3, 1)
			end
			if u >= 1 then f.BackgroundTransparency = 1 end
		end)
	end
	function FX.emitter(holder, kind, color, o) -- ParticleEmitter texturé ; Rate 0 = rafales avec Emit
		o = o or {}
		if not o.tex and VFX and VFX.on then o.tex, o.grid = VFX.map(kind) end
		local life, speed = o.life or 1, o.speed or 10
		return new('ParticleEmitter', {Texture = o.tex or FX.TEX[kind] or FX.TEX.spark,
			FlipbookLayout = o.grid == 8 and Enum.ParticleFlipbookLayout.Grid8x8 or (o.grid == 4
				and Enum.ParticleFlipbookLayout.Grid4x4 or Enum.ParticleFlipbookLayout.None),
			FlipbookMode = o.loop and Enum.ParticleFlipbookMode.Loop or Enum.ParticleFlipbookMode.OneShot,
			FlipbookFramerate = NumberRange.new(o.fps or 12),
			Orientation = o.flat and Enum.ParticleOrientation.VelocityPerpendicular or (o.worldUp
				and Enum.ParticleOrientation.FacingCameraWorldUp or Enum.ParticleOrientation.FacingCamera),
			Color = typeof(color) == 'ColorSequence' and color or ColorSequence.new(color or WHITE),
			LightEmission = o.emission or 1, LightInfluence = 0, Brightness = o.brightness or 2,
			Rate = o.rate or 0, Lifetime = NumberRange.new(life * .6, life),
			Speed = NumberRange.new(speed * .45, speed), SpreadAngle = o.spread or Vector2.new(180, 180),
			Acceleration = o.accel or Vector3.zero, Drag = o.drag or 2,
			Rotation = o.rot and NumberRange.new(o.rot) or NumberRange.new(0, 360),
			RotSpeed = o.rot and NumberRange.new(o.spin or 0) or NumberRange.new(-120, 120), EmissionDirection = o.dir or Enum.NormalId.Top,
			ZOffset = o.z or 0, LockedToPart = o.locked == true,
			Size = NumberSequence.new({NumberSequenceKeypoint.new(0, o.size or 2), NumberSequenceKeypoint.new(1, o.size1 or 0)}),
			Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, o.t0 or 0),
				NumberSequenceKeypoint.new(.7, o.tm or .45), NumberSequenceKeypoint.new(1, 1)})}, holder)
	end
	function FX.burst(pos, kind, n, color, o) -- rafale unique, nettoyée toute seule
		o = o or {}
		local holder = anchorAt(pos)
		local e = FX.emitter(holder, kind, color, o)
		e:Emit(math.max(1, math.floor(Q(n, n * .5))))
		task.delay((o.life or 1) + 1, function() if holder.Parent then holder:Destroy() end end)
		return e
	end
	function FX.lightFlash(pos, color, brightness, dur)
		local h = anchorAt(pos)
		local l = light(h, color, 60, brightness)
		FX.anim(dur or 1.2, function(u)
			l.Brightness = brightness * (1 - u) ^ 2
			if u >= 1 then h:Destroy() end
		end)
	end
	function FX.shock(pos, color, radius, dur, thick) -- anneau au sol + nappe lumineuse qui s'étendent
		if VFX and VFX.on then
			VFX.flip(pos + V(0, .6, 0), color.B > color.R and 'ring_electric' or 'ring_fire', WHITE, radius * 2.2, dur or .9,
				{flat = true})
			return
		end
		local th = thick or 1.2
		local r = ringNew(effects, Q(48, 28), color, Enum.Material.Neon, th, th * .45, .15)
		local glow = disc(pos + V(0, .22, 0), 1, .16, color, effects, Enum.Material.Neon, .55)
		FX.anim(dur or .9, function(u)
			local e = easeOut(u)
			ringSet(r, pos + V(0, .4, 0), math.max(.5, radius * e), nil, .15 + .85 * u)
			local d = math.max(.2, radius * 1.5 * e)
			glow.Size = V(.16, d, d)
			glow.Transparency = .55 + .45 * u
			if u >= 1 then
				ringKill(r)
				glow:Destroy()
			end
		end)
	end
	function FX.dome(pos, color, radius, dur) -- sphère de souffle qui gonfle et s'efface
		if VFX and VFX.on then return end
		local b = ball(pos, 1, color, effects, Enum.Material.Neon, .55)
		FX.anim(dur or .7, function(u)
			local d = math.max(.5, radius * 2 * easeOut(u))
			b.Size = V(d, d, d)
			b.Transparency = .55 + .45 * u
			if u >= 1 then b:Destroy() end
		end)
	end
	function FX.scorch(pos, radius, hot) -- sol noirci + fissures incandescentes qui refroidissent
		if VFX and VFX.on then
			VFX.cracks(pos, radius * 1.3)
			return
		end
		disc(pos + V(0, .06, 0), radius * 2, .1, C(24, 19, 17), effects, Enum.Material.Slate, .08)
		local rng, cracks = Random.new(), {}
		for k = 1, Q(12, 7) do
			local a = rng:NextNumber(0, TAU)
			local dir = V(math.cos(a), 0, math.sin(a))
			cracks[k] = line(pos + dir * radius * rng:NextNumber(.12, .35) + V(0, .16, 0),
				pos + dir * radius * rng:NextNumber(.75, 1.08) + V(0, .16, 0), rng:NextNumber(.22, .5), hot or EMBER)
		end
		FX.anim(8, function(u)
			local c = (hot or EMBER):Lerp(C(70, 20, 12), easeIn(u))
			for _, s in ipairs(cracks) do
				s.Color = c
				s.Transparency = .05 + .55 * u
			end
		end)
	end
	function FX.debris(pos, n, color, material, power, size, hot) -- éclats en vol balistique, rebond amorti
		local rng = Random.new()
		local char = player.Character
		FX.rp.FilterDescendantsInstances = char and {root, char} or {root}
		local list = {}
		for i = 1, math.floor(Q(n, n * .5)) do
			local s = (size or 1.4) * rng:NextNumber(.5, 1.35)
			local p = part(V(s, s * rng:NextNumber(.45, 1), s * rng:NextNumber(.6, 1.2)),
				CF(pos + V(rng:NextNumber(-2, 2), 1.2, rng:NextNumber(-2, 2))) * CFrame.Angles(rng:NextNumber(0, TAU),
				rng:NextNumber(0, TAU), 0), hot or color, effects, hot and Enum.Material.Neon or material or Enum.Material.Slate)
			local a, up = rng:NextNumber(0, TAU), rng:NextNumber(.4, 1)
			local v = V(math.cos(a) * (1.1 - up * .6), up, math.sin(a) * (1.1 - up * .6)).Unit * (power or 60) * rng:NextNumber(.45, 1.1)
			list[i] = {p = p, v = v, w = V(rng:NextNumber(-9, 9), rng:NextNumber(-9, 9), rng:NextNumber(-9, 9)), live = true}
		end
		local last = os.clock()
		FX.anim(5, function(u, now)
			local dt = math.min(now - last, .05) * S.speed
			last = now
			for _, d in ipairs(list) do
				if d.p.Parent then
					if d.live and dt > 0 then
						local from = d.p.Position
						d.v = d.v - V(0, workspace.Gravity * .55 * dt, 0)
						local to = from + d.v * dt
						local hit = workspace:Raycast(from, to - from, FX.rp)
						if hit then
							to = hit.Position + hit.Normal * d.p.Size.Y * .4
							if d.v.Magnitude > 22 then
								d.v = (d.v - 2 * d.v:Dot(hit.Normal) * hit.Normal) * .32
							else
								d.live = false
							end
						end
						d.p.CFrame = CF(to) * (d.p.CFrame - d.p.Position) * CFrame.Angles(d.w.X * dt, d.w.Y * dt, d.w.Z * dt)
					end
					if hot then d.p.Color = hot:Lerp(color, span(u, .05, .5)) end
					if u > .8 then d.p.Transparency = span(u, .8, 1) end
					if u >= 1 then d.p:Destroy() end
				end
			end
		end)
	end
	function FX.glowBeam(a0, a1, color, width, o) -- faisceau en 3 couches (cœur blanc, couleur, halo)
		o = o or {}
		local list = {}
		for i, L in ipairs({{.3, WHITE, 0}, {1, color, .2}, {2.8, color, .72}}) do
			list[i] = new('Beam', {Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(L[2]),
				Width0 = width * L[1], Width1 = width * L[1] * (o.taper or 1), LightEmission = 1, LightInfluence = 0,
				Brightness = o.brightness or 3, FaceCamera = true, Segments = 1,
				Transparency = NumberSequence.new(L[3])}, a0.Parent)
			if VFX and VFX.on and VFX.id.ray_v then
				list[i].Width0, list[i].Width1 = width * L[1] * 3, width * L[1] * 3 * (o.taper or 1)
				VFX.skin(list[i], 4 + i * 2, width * L[1] * 6)
			end
		end
		return list
	end
	function FX.impact(pos, color, scale, o) -- impact complet : image, lueur, feu, étincelles, fumée, onde, éclats
		o = o or {}
		local s = scale or 1
		FX.impactFrame(o.frame or color)
		FX.pulse({bloom = 1.6, size = 22, bright = .26, contrast = .18, blur = 12, sat = .15, rays = .25, fov = 7, vig = .25},
			.03, .08, .95)
		FX.lightFlash(pos + V(0, 6 * s, 0), color, 16, 1.6)
		if VFX and VFX.on then -- pack : seulement ses textures (plus les éclats 3D et la lumière)
			VFX.impact(pos, color, s, o.scorch)
			if o.debris ~= false then
				FX.debris(pos, 18, o.debrisColor or C(72, 66, 60), Enum.Material.Slate, 70 * s, 1.6 * s, o.hot)
			end
			shake(1.4 * s, 1.2)
			return
		end
		FX.burst(pos + V(0, 2 * s, 0), 'fire', 26, ColorSequence.new(WHITE, color), {life = .9, speed = 30 * s,
			size = 10 * s, size1 = 2 * s, drag = 4, accel = V(0, 12, 0), brightness = 3})
		FX.burst(pos + V(0, 1, 0), 'spark', 70, color, {life = 1.5, speed = 80 * s, size = 1 * s, drag = 1.1,
			accel = V(0, -45, 0), brightness = 5})
		FX.burst(pos + V(0, 1.5 * s, 0), 'smoke', 28, C(74, 66, 62), {life = 2.8, speed = 24 * s, size = 10 * s,
			size1 = 20 * s, drag = 2.4, emission = 0, t0 = .35, tm = .62, accel = V(0, 3, 0)})
		FX.shock(pos, color, 48 * s, .95, 1.4 * s)
		if o.dome ~= false then FX.dome(pos, color, 22 * s, .6) end
		if o.debris ~= false then
			FX.debris(pos, 18, o.debrisColor or C(72, 66, 60), Enum.Material.Slate, 70 * s, 1.6 * s, o.hot)
		end
