		local corona = nil
		if not waitUntil(id, totAt, function()
			local t = os.clock()
			local k = smooth(span(t, darkAt, diamondAt))
			moon.Position = moonFrom:Lerp(moonTo, k)
			sunGlow.Transparency = .7 + .25 * k
			markSet(.4 + .6 * k, t)
			for _, s in ipairs(stars) do s.Transparency = 1 - .85 * span(t, darkAt + 2 / S.speed, diamondAt) end
			local ur = R * 4 * k
