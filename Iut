	-- OUTILS DES ATTAQUES SS-08 À SS-16 ---------------------------------------------------------------
	local AX = {}
	function AX.keep(ctx, o) -- objet (ou anneau) retiré à la fin de la phase active
		ctx.tmp = ctx.tmp or {}
		table.insert(ctx.tmp, o)
		return o
	end
	function AX.clear(ctx)
		for _, o in ipairs(ctx.tmp or {}) do
			if typeof(o) == 'Instance' then
				if o.Parent then o:Destroy() end
			elseif type(o) == 'table' and o.parts then
				ringKill(o)
			end
		end
		ctx.tmp = nil
	end
	function AX.zigzag(a, b, jag, n) -- points d'un éclair entre a et b
		local pts = {a}
		for k = 1, (n or 9) - 1 do
			local t = k / (n or 9)
			pts[#pts + 1] = a:Lerp(b, t) + V(math.random() - .5, (math.random() - .5) * .3, math.random() - .5) * jag
		end
		pts[#pts + 1] = b
		return pts
	end
	function AX.bolt(a, b, col, width, life) -- éclair 3D bref : cœur blanc + gaine colorée + ramifications, s'éteint seul
		local pts, list = AX.zigzag(a, b, (a - b).Magnitude * .08, 10), {}
		for k = 1, #pts - 1 do
			list[#list + 1] = line(pts[k], pts[k + 1], width, WHITE)
			list[#list + 1] = line(pts[k], pts[k + 1], width * 3, col, effects, Enum.Material.Neon, .55)
			if math.random() < .35 then
				local q = pts[k] + V(math.random() - .5, -math.random() * .6, math.random() - .5) * (a - b).Magnitude * .12
				list[#list + 1] = line(pts[k], q, width * .6, col)
			end
		end
		FX.anim(life or .35, function(u)
			for _, s in ipairs(list) do s.Transparency = math.max(s.Transparency, span(u, .3, 1)) end
			if u >= 1 then for _, s in ipairs(list) do s:Destroy() end end
		end)
		return list
	end
	function AX.faceRing(r, center, radius, transparency) -- anneau tourné vers la caméra (lumière déviée)
		local cam = workspace.CurrentCamera
		if not cam then return end
		local d = cam.CFrame.Position - center
		if d.Magnitude < 1 then return end
		local up = d.Unit
		local right = up:Cross(math.abs(up.Y) > .9 and Vector3.xAxis or Vector3.yAxis).Unit
		ringSet(r, center, radius, CFrame.fromMatrix(Vector3.zero, right, up, right:Cross(up)), transparency)
	end
	function AX.rock(pos, s, col) -- éclat de roche anguleux
		return part(V(s, s * (.55 + math.random() * .4), s * (.7 + math.random() * .5)),
			CF(pos) * CFrame.Angles(math.random() * TAU, math.random() * TAU, math.random() * TAU), col or C(92, 86, 80),
			effects, Enum.Material.Slate)
	end
	function AX.arcs(center, radius, n, col, width, parent) -- arcs de champ magnétique (demi-ellipses verticales)
		local list = {}
		for k = 1, n do
			local a = k / n * math.pi
			local d = V(math.cos(a), 0, math.sin(a))
			local prev = nil
			for j = 0, 16 do
				local t = j / 16 * math.pi
				local q = center + d * math.cos(t) * radius + V(0, math.sin(t) * radius * .6, 0)
				if prev then list[#list + 1] = line(prev, q, width, col, parent) end
				prev = q
			end
		end
		return list
	end
	function AX.camOrbit(id, ctx, R, dur, a0, a1, h0, h1, look0, look1, fov) -- plan d'impact en orbite lente
		local p = ctx.pos
		return tween(id, dur, function(u, e)
			local a = lerp(a0, a1, e)
			local dir = ctx.right * math.cos(a) - ctx.fwd * math.sin(a)
			local c = p + dir * R + V(0, lerp(h0, h1, e), 0)
			icam(id, look(c, p + V(0, lerp(look0, look1, e), 0)), fov or 72)
		end)
	end
	function AX.spinner() -- angle cumulé (rad) : la vitesse peut changer sans à-coups
		local sp = {a = 0, t = os.clock()}
		function sp.step(rate)
			local now = os.clock()
			sp.a = sp.a + (now - sp.t) * rate * S.speed
			sp.t = now
			return sp.a
		end
		return sp
	end
	function AX.screen(a, b) -- angle (degrés, sens horaire) et longueur à l'écran du segment a → b
		local cam = workspace.CurrentCamera
		if not cam then return nil end
		local pa, va = cam:WorldToViewportPoint(a)
		local pb, vb = cam:WorldToViewportPoint(b)
		if pa.Z <= 0 or pb.Z <= 0 then return nil end
		local dx, dy = pb.X - pa.X, pb.Y - pa.Y
		return math.deg(math.atan2(dy, dx)), math.sqrt(dx * dx + dy * dy), (pa.Z + pb.Z) / 2
	end
	-- Image du pack posée dans le monde (BillboardGui) : fixe, animée (planches 4×4 / 8×8) ou tournée.
	function AX.board(holder, name, color, w, h, o)
		local id = VFX.id[name]
		if not id then return nil end
		o = o or {}
		local g = new('BillboardGui', {Adornee = holder, Size = UDim2.fromScale(w, h), LightInfluence = 0,
			Brightness = o.brightness or 2, AlwaysOnTop = o.top == true, ResetOnSpawn = false}, holder)
		local img = new('ImageLabel', {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = id, ImageColor3 = color or WHITE,
			ImageTransparency = o.alpha or 0, Rotation = o.rot or 0}, g)
		local grid = VFX.FLIP[name]
		if grid then
			local cell, n, fps, t0 = 1024 / grid, grid * grid, o.fps or 14, os.clock()
			img.ImageRectSize = Vector2.new(cell, cell)
			FX.anim(o.life or 60, function(u, now)
				if not img.Parent then return end
				local k = o.once and math.min(n - 1, math.floor(u * n)) or (math.floor((now - t0) * fps) % n)
				img.ImageRectOffset = Vector2.new((k % grid) * cell, math.floor(k / grid) * cell)
				if o.once and u >= 1 then g:Destroy() end
			end)
		end
		return g, img
	end
	-- Bande d'image tendue entre deux points (éclair, cône, météore) : un panneau tourné à chaque
	-- image dans la direction du segment à l'écran. axis : angle de la texture (90 = vers le bas).
	function AX.strip(name, color, width, o)
		local id = VFX.id[name]
		if not id then return nil end
		o = o or {}
		local h = anchorAt(Vector3.zero)
		local g = new('BillboardGui', {Adornee = h, Size = UDim2.fromScale(width, width), LightInfluence = 0,
			Brightness = o.brightness or 2.5, ResetOnSpawn = false}, h)
		local img = new('ImageLabel', {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = id, ImageColor3 = color or WHITE,
			ImageTransparency = o.alpha or 0}, g)
		local grid = VFX.FLIP[name]
		local s = {holder = h, gui = g, img = img, axis = o.axis or 90, width = width, t0 = os.clock()}
		if grid then
			s.cell, s.grid, s.n = 1024 / grid, grid, grid * grid
			img.ImageRectSize = Vector2.new(s.cell, s.cell)
		end
		function s.set(a, b, w, alpha) -- à appeler à chaque image
			if not h.Parent then return end
			h.Position = (a + b) / 2
			local ang, len, depth = AX.screen(a, b)
			local cam = workspace.CurrentCamera
			if not ang or not cam then
				g.Enabled = false
				return
			end
			g.Enabled = true
			local ppx = cam.ViewportSize.Y / 2 / (math.max(depth, .1) * math.tan(math.rad(cam.FieldOfView) / 2))
			local studs = len / math.max(ppx, 1e-3) * (o.over or 1)
			if o.across then -- texture « dans la largeur » (cônes, rayons) : hauteur = longueur
				g.Size = UDim2.fromScale(w or s.width, studs)
			else
				g.Size = UDim2.fromScale(w or s.width, studs)
			end
			img.Rotation = ang - s.axis
			if alpha then img.ImageTransparency = alpha end
			if s.grid then
				local k = o.once and math.min(s.n - 1, math.floor((os.clock() - s.t0) / (o.life or 1) * s.n))
					or (math.floor((os.clock() - s.t0) * (o.fps or 16)) % s.n)
				img.ImageRectOffset = Vector2.new((k % s.grid) * s.cell, math.floor(k / s.grid) * s.cell)
			end
		end
		return s
	end
	-- Gerbe de rayons (god_rays du pack, origine au centre de l'image) : n copies tournées.
	function AX.rays(holder, color, size, n, alpha)
		local id = VFX.id.god_rays
		if not id then return nil end
		local g = new('BillboardGui', {Adornee = holder, Size = UDim2.fromScale(size, size), LightInfluence = 0,
			Brightness = 3, ResetOnSpawn = false}, holder)
		local imgs = {}
		for k = 1, n do
			imgs[k] = new('ImageLabel', {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
				Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = id, ImageColor3 = color,
				ImageTransparency = alpha or 0, Rotation = k / n * 360}, g)
		end
		return {gui = g, imgs = imgs, n = n}
	end
	function AX.raysSet(r, size, spin, alpha) -- taille (studs), angle de base (degrés), transparence
		if not r then return end
		r.gui.Size = UDim2.fromScale(size, size)
		for k, im in ipairs(r.imgs) do
			im.Rotation = spin + k / r.n * 360 + (k % 2) * 17
			if alpha then im.ImageTransparency = alpha end
		end
	end
	function AX.fade(list, dur, from, kill) -- pièces qui s'effacent (et disparaissent)
		FX.anim(dur, function(u)
			for _, s in ipairs(list) do
				if s.Parent then s.Transparency = lerp(from or s.Transparency, 1, u) end
			end
			if u >= 1 and kill ~= false then for _, s in ipairs(list) do if s.Parent then s:Destroy() end end end
		end)
	end
	function AX.cone(a, b, color, w0, w1, o) -- cône de lumière doux (2 faisceaux : cœur + halo)
		o = o or {}
		local h = anchorAt(a)
		local a0, a1 = attach(h, a), attach(h, b)
		local glowTex = VFX.id.ray_glow
		local core = new('Beam', {Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(WHITE:Lerp(color, .35)),
			Width0 = w0 * .3, Width1 = w1 * .3, LightEmission = 1, LightInfluence = 0, Brightness = o.brightness or 3,
			FaceCamera = true, Segments = 1, Transparency = NumberSequence.new(o.core or .15)}, h)
		local halo = new('Beam', {Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(color), Width0 = w0, Width1 = w1,
			LightEmission = 1, LightInfluence = 0, Brightness = o.brightness or 3, FaceCamera = true, Segments = 1,
			Texture = glowTex, TextureMode = Enum.TextureMode.Stretch, TextureLength = 1,
			Transparency = NumberSequence.new(o.halo or .45)}, h)
		local c = {holder = h, a0 = a0, a1 = a1, core = core, halo = halo, w0 = w0, w1 = w1}
		function c.set(pa, pb, k, alpha) -- k : facteur de largeur
			a0.WorldPosition, a1.WorldPosition = pa, pb
			k = k or 1
			core.Width0, core.Width1, halo.Width0, halo.Width1 = c.w0 * .3 * k, c.w1 * .3 * k, c.w0 * k, c.w1 * k
			if alpha then
				core.Transparency = NumberSequence.new(clamp(alpha, 0, 1))
				halo.Transparency = NumberSequence.new(clamp(alpha + .3, 0, 1))
			end
		end
		return c
	end

	ATTACKS[7] = function(id, ctx) -- SS-08 HORIZON
		local p, sz = ctx.pos, ctx.size
		local col, R = C(255, 150, 60), 32 * sz
		if not remoteArm(id, 'star_arm', 'star_press') then return end
		if not waitUntil(id, at(ctx, .8)) then return end
		cue('bh_mark')
		local g = p + V(0, .1, 0)
		local well = disc(g, 6 * sz, .12, BLACK, effects, Enum.Material.SmoothPlastic)
		local rim = ring(g + V(0, .05, 0), 3.4 * sz, col, effects, 40, .3)
		local outer = ring(g, 18 * sz, col, effects, Q(56, 40), .16, nil, Enum.Material.Neon, .5)
		local arms = {}
		for k = 1, 8 do
			arms[k] = {}
			for j = 1, 10 do
				arms[k][j] = part(V(.45, .1, 1.7) * sz, CF(g), C(20, 16, 18), effects, Enum.Material.SmoothPlastic)
