					rk.p.CFrame = CF(p:Lerp(skyPos, k2) + V(math.cos(a) * r, .6, math.sin(a) * r))
						* CFrame.Angles(t * rk.spin.X, t * rk.spin.Y, t * rk.spin.Z)
					if k2 >= .98 then rk.p:Destroy() end
				end
			end
			banner(id, 'SS-08 · EVENT HORIZON', col, ctx.strike - t)
