		-- La Lune glisse devant le Soleil : la lumière baisse, les étoiles apparaissent
		cue('eclipse_partial')
		caption('La Lune glisse devant le Soleil : la lumière baisse')
		ctx.skyFocus = ePos
		FX.pulse({bright = -.55, contrast = .2, sat = -.35, tint = C(255, 222, 196), vig = .45}, 5.2, 2.4, 2.2)
		local stars = {}
		for k = 1, Q(44, 22) do
			local a, el = math.random() * TAU, math.rad(18 + math.random() * 68)
			stars[k] = ball(p + V(math.cos(a) * math.cos(el), math.sin(el), math.sin(a) * math.cos(el)) * 650,
				1.6 + math.random() * 2.2, C(225, 232, 255), effects, Enum.Material.Neon, 1)
		end
		local umbraG = disc(p + V(0, .09, 0), 1, .1, C(4, 4, 8), effects, Enum.Material.SmoothPlastic, .5)
		local smoke = FX.emitter(holder, 'smoke', C(20, 16, 18), {tex = VFX.id.dark_smoke, rate = 0, life = 3.4, speed = 6,
