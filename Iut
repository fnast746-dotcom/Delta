	function VFX.bolt(h, a0, a1, color, width) -- éclair du pack le long d'un rayon, qui crépite
		if not VFX.id.lightning then return nil end
		local b = new('Beam', {Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(color), Texture = VFX.id.lightning,
			TextureMode = Enum.TextureMode.Wrap, TextureLength = width * 2, TextureSpeed = 0, LightEmission = 1,
			LightInfluence = 0, Brightness = 4, FaceCamera = true, Segments = 1, Width0 = width, Width1 = width}, h)
		local rng = Random.new()
		FX.anim(60, function()
			if not b.Parent then return end
			b.TextureLength = width * rng:NextNumber(1.2, 3)
			b:SetTextureOffset(rng:NextNumber(0, 1))
			b.Transparency = NumberSequence.new(rng:NextNumber() < .3 and .85 or .05)
		end)
		return b
	end
	function VFX.dress(cols, layers) -- colonnes néon masquées, remplacées par des rayons d'énergie du pack
		if not (VFX.on and VFX.id.ray_v) then return end
		for i, c in ipairs(cols) do
			c.LocalTransparencyModifier = 1
			local L, cf = c.Size.X, c.CFrame
			local h = anchorAt(cf.Position)
			local a0, a1 = attach(h, cf:PointToWorldSpace(V(L / 2, 0, 0))), attach(h, cf:PointToWorldSpace(V(-L / 2, 0, 0)))
			local b = new('Beam', {Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(layers[i][2]),
				Texture = VFX.id.ray_v, TextureMode = Enum.TextureMode.Wrap, TextureLength = 60, TextureSpeed = 8 + i * 3,
				LightEmission = 1, LightInfluence = 0, Brightness = 3, FaceCamera = true, Segments = 1, Width0 = 1, Width1 = 1}, h)
			local glow = VFX.id.ray_glow and new('Beam', {Attachment0 = a0, Attachment1 = a1,
				Color = ColorSequence.new(layers[i][2]), Texture = VFX.id.ray_glow, TextureMode = Enum.TextureMode.Wrap,
				TextureLength = 80, LightEmission = 1, LightInfluence = 0, Brightness = 2, FaceCamera = true, Segments = 1,
				Width0 = 1, Width1 = 1}, h) or nil
			local zap = i == 2 and VFX.bolt(h, a0, a1, layers[i][2], 10) or nil
			FX.anim(60, function()
				if not c.Parent then
					if h.Parent then h:Destroy() end
					return
				end
				local d = math.max(.2, c.Size.Y * 1.3)
				b.Width0, b.Width1, b.TextureLength = d, d, d * 2
				b.Transparency = NumberSequence.new(clamp(c.Transparency, 0, 1))
				if glow then
					glow.Width0, glow.Width1 = d * 1.5, d * 1.5
					glow.Transparency = NumberSequence.new(clamp(c.Transparency + .2, 0, 1))
				end
				if zap then zap.Width0, zap.Width1 = d * .8, d * .8 end
			end)
		end
	end
	function VFX.trails(holder) -- traînée d'étoile filante sur les Trail d'un objet
