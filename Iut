		local appear = at(ctx, 1.5)
		local darkAt = ctx.strike - 7 / S.speed
		local t1 = os.clock()
		if not waitUntil(id, darkAt, function()
			local t = os.clock()
			markSet(span(t, t1, darkAt) * .4, t)
