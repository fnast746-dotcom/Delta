		FX.pulse({bright = -.08, contrast = .2, sat = .25, bloom = .9, size = 22, tint = C(255, 205, 240), vig = .3}, 3.6, 3.2, 1.6)
		local shell = new('Part', {Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
			Transparency = 1, Shape = Enum.PartType.Ball, Size = V(60, 60, 60) * sz, Position = cpos}, effects)
		local inflow = FX.emitter(shell, 'spark', HOT, {rate = Q(70, 35), life = .9, speed = 50 * sz, size = 1, size1 = .3,
			brightness = 5, drag = 0})
		pcall(function()
			inflow.Shape = Enum.ParticleEmitterShape.Sphere
			inflow.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
			inflow.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		end)
		local orbB = ball(cpos, 1, WHITE, effects)
		local orbG = ball(cpos, 1, col, effects, Enum.Material.Neon, .5)
		local ch = anchorAt(cpos)
		VFX.attach(ch, 'orb', WHITE, 30 * sz, 1.4, 1.2, {loop = true, fps = 24})
		local cl = light(ch, col, 60, 3)
		if not tween(id, 4, function(u)
			local t = os.clock()
			reticle(2.2 + 5 * u, 1)
			local s = (2 + 16 * easeIn(u)) * sz * (1 + .08 * math.sin(t * 30))
			orbB.Size, orbG.Size = V(s, s, s), V(s, s, s) * 2
			cl.Brightness = 3 + 8 * u
			local flick = .5 + .5 * math.sin(t * 40)
			laser.Transparency = NumberSequence.new(.1 + .3 * flick)
			laser.Width0, laser.Width1 = 1.6 + 2 * u, 1 + 1.6 * u
			laserGlow.Width0, laserGlow.Width1 = 6 + 8 * u, 4 + 6 * u
			hl.Brightness = 1.5 + 4 * u
			banner(id, 'SS-16 · CHARGE', col, ctx.strike - t, string.format('   %d %%', math.floor(u * 100)))
		end) then return end
		-- Frappe : colonne gamma de 3 s, sol fondu, trois ondes radiales
		countdownHide()
		cue('quasar_impact')
		lockH:Destroy()
		inflow.Enabled = false
		flash(WHITE, 1, 1)
		FX.impact(p, col, sz * 2.2, {frame = WHITE, debrisColor = C(60, 30, 50), hot = HOT})
		VFX.flip(p + V(0, R * .5, 0), 'boom2', col, R * 4, 1, {z = 2})
		shake(3, 2.5)
		caption('Colonne gamma : trois secondes de lumière pure')
		tele('GAMMA-RAY BURST · 10⁴⁴ J\nGROUND · 9 000 °C')
		local layers = {{.32, WHITE, 0}, {.62, HOT, .2}, {.95, col, .45}, {1.45, col, .78}}
		local cols = {}
		for i, L in ipairs(layers) do cols[i] = cyl(p - V(0, 30, 0), skyTop, .2, L[2], effects, Enum.Material.Neon, L[3]) end
		VFX.dress(cols, layers)
		local melt = disc(p + V(0, .12, 0), 1, .14, MOLT, effects, Enum.Material.Neon, .1)
		local meltH = anchorAt(p + V(0, 1, 0))
		local bubbles = FX.emitter(meltH, 'spark', MOLT, {rate = Q(60, 30), life = 1.2, speed = 18 * sz, size = .9, drag = 1,
			accel = V(0, -26, 0), spread = Vector2.new(70, 70), brightness = 4})
		local waves = 0
		local camFar = p - ctx.fwd * R * 4.2 + ctx.right * R * 1.4 + V(0, 3, 0)
		local camO = AX.spinner()
		if not tween(id, 3.4, function(u, e)
			local t = os.clock()
			local w = easeOut(math.min(1, u * 8)) * (1 - span(u, .85, 1) * .7)
			for i, L in ipairs(layers) do
				local d = math.max(.2, R * 1.2 * L[1] * w * (1 + .06 * math.sin(t * 60 + i)))
				cols[i].Size = V(cols[i].Size.X, d, d)
			end
			local mr = R * 2 * easeOut(math.min(1, u * 2))
			melt.Size = V(.14, math.max(1, mr), math.max(1, mr))
			melt.Color = MOLT:Lerp(col, .5 + .5 * math.sin(t * 6))
			local due = math.floor(u * 3.4 / 1.05)
