				waves = waves + 1
				FX.shock(p, waves == 2 and WHITE or col, R * (3.2 + waves), 1, 1.8 * sz)
				VFX.flip(p + V(0, .8, 0), 'ring_electric', WHITE, R * (3.4 + waves * 1.3), .8, {flat = true})
				for k = 1, 5 do
					local a = k / 5 * TAU + math.random() * .6
					local d = V(math.cos(a), 0, math.sin(a))
					AX.bolt(p + d * R * .5 + V(0, .4, 0), p + d * R * (1.8 + math.random() * .6) + V(0, .4, 0), col, .3 * sz, .4)
				end
				FX.debris(p, 10, C(70, 40, 60), Enum.Material.Basalt, 70 * sz, 1.4 * sz)
				shake(1.4, .5)
			end
			if u < .3 then
				icam(id, look(camFar, p + V(0, R * 2.2, 0)), 82)
			elseif u < .8 then
				local a = 2.4 + camO.step(.9)
				local dir = ctx.right * math.cos(a) - ctx.fwd * math.sin(a)
				icam(id, look(p + dir * R * 1.7 + V(0, R * .25, 0), p + V(0, R * .5, 0)), 76)
			else
				local k = span(u, .8, 1)
				icam(id, look((p - ctx.fwd * R * 2 + ctx.right * R):Lerp(camFar + V(0, R * .6, 0), smooth(k)), p + V(0, R * 1.2, 0)), 74)
			end
		end) then return end
		for _, c in ipairs(cols) do c:Destroy() end
		bubbles.Rate = Q(14, 7)
		shell:Destroy()
		orbB:Destroy()
		orbG:Destroy()
		ch:Destroy()
		-- Restes : cratère cerclé de magenta, cœur fondu qui refroidit, écho du jet qui s'efface
		cue('quasar_after')
		caption('Il reste un cratère fondu et l’écho du jet qui s’efface')
		tele('CRATER · Ø ' .. math.floor(R * 2.4 + .5) .. ' STUDS\nJET ECHO · FADING')
		local crater = disc(p + V(0, .08, 0), R * 2.6, .12, C(26, 14, 24), effects, Enum.Material.Basalt)
		local rim = ring(p + V(0, .25, 0), R * 1.3, col, effects, Q(56, 40), .9 * sz)
		local echo = cyl(p - V(0, 5, 0), skyTop, R * .3, col, effects, Enum.Material.Neon, .7)
		local embers = FX.emitter(meltH, 'spark', HOT, {rate = Q(16, 8), life = 3, speed = 3, size = .5, accel = V(0, 6, 0),
			spread = Vector2.new(60, 60), brightness = 3})
		AX.camOrbit(id, ctx, R * 2.3, 2.2, 2.0, 2.9, R * .7, R * 1.1, 0, R * .2, 66)
		local t2 = os.clock()
		addAmbient(function(t)
			local k = math.min(1, (t - t2) / 7)
			melt.Color = col:Lerp(C(60, 20, 40), k)
			melt.Transparency = .1 + .3 * k
			echo.Transparency = .7 + .3 * k + .05 * math.sin(t * 25)
			local w = R * .3 * (1 - k * .7)
			echo.Size = V(echo.Size.X, math.max(.2, w), math.max(.2, w))
			for i, s in ipairs(rim.parts) do s.Color = col:Lerp(HOT, (math.sin(t * 2 + i * .4) + 1) * .25) end
			embers.Rate = Q(16, 8) * (1 - k * .8)
			reticle(.3, 1)
		end)
	end

	-- OUTIL, LANCEMENT, ANNULATION ------------------------------------------------------------
	local toolConnections, giveEpoch = {}, 0
	local function equipped()
		return S.tool ~= nil and player.Character ~= nil and S.tool.Parent == player.Character
	end
	local function removeTool()
		for _, c in ipairs(toolConnections) do c:Disconnect() end
		table.clear(toolConnections)
		if S.tool then S.tool:Destroy() end
		S.tool = nil
	end
	local function giveTool()
		if S.dead then return nil end
		local backpack = player:FindFirstChildOfClass('Backpack')
		if not backpack then return nil end
		if S.tool and (S.tool.Parent == backpack or S.tool.Parent == player.Character) then return S.tool end
		removeTool()
		local t = new('Tool', {Name = 'Stellar Remote', RequiresHandle = false, CanBeDropped = false,
			ToolTip = 'The Shooting Star · 5 capacités locales', ManualActivationOnly = false}, backpack)
		S.tool = t
		table.insert(toolConnections, t.Equipped:Connect(guard(function()
			if S.dead then return end
			UI.panel.Visible = true
			status(SYSTEMS[S.selected].note)
			refreshUI()
		end)))
		table.insert(toolConnections, t.Activated:Connect(guard(function()
			-- Clic ou toucher dans le monde, télécommande en main : la frappe part à cet endroit.
			-- (Un glissé pour tourner la caméra ne déclenche pas l'outil.)
			if not launch then return end
			local ok, ray = pcall(function() return player:GetMouse().UnitRay end)
			launch(ok and ray or nil)
		end)))
		table.insert(toolConnections, t.Unequipped:Connect(guard(function()
			-- Ne coupe plus le sort : certains jeux rangent les outils d'eux-mêmes (ANNULER ou X pour arrêter).
			refreshUI()
		end)))
		return t
	end
	local function equipTool()
		if S.dead then return false end
		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass('Humanoid')
		if not humanoid or humanoid.Health <= 0 then
			status('Attends la réapparition de ton personnage.')
			return false
		end
		local t = giveTool()
		if not t then
			status('Inventaire en cours de chargement.')
			return false
		end
		if t.Parent ~= char then humanoid:EquipTool(t) end
		return t.Parent == char
	end
	local function runAttack(id, index, ctx)
		FX.grade = FX.GRADES[index] or {tint = SYSTEMS[index].color:Lerp(WHITE, .82), sat = .1, contrast = .08, bloom = .6, size = 28}
		if S.films then
			local f = filmBegin(id, index, ctx)
			if f then
				f.stopAt = ctx.strike
				task.spawn(function()
					local ok, err = xpcall(FILMS[index], debug.traceback, id, ctx)
					if not ok then
						if film and film.id == id then filmEnd() end
						reportError('film : ' .. tostring(err))
					end
				end)
			end
		end
		ATTACKS[index](id, ctx)
		if active(id) then FX.grade = nil end
	end
	cancel = function()
		S.gen = S.gen + 1
		S.busy = false
		S.cover, S.press = 0, 0
		filmEnd()
		countdownHide()
		clearEffects()
		filmFx:ClearAllChildren()
		if not S.dead then
			status(SYSTEMS[S.selected].note)
			refreshUI()
		end
	end
	launch = function(fromRay)
		if S.dead then return end
		if S.busy then
			toast('Déjà en cours : touche ANNULER (ou X) pour arrêter.', 'warn', 3)
			return
		end
		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass('Humanoid')
		if not humanoid or humanoid.Health <= 0 then
			toast('Attends que ton personnage réapparaisse, puis réessaie.', 'warn', 4)
			return
		end
		equipTool() -- facultatif : la frappe part même si le jeu refuse ou range l'outil
		local pos, hit = aim(fromRay)
		if not pos then
			local why = fromRay and 'Rien à cet endroit : touche le sol ou un décor.' or 'Rien sous le + : vise le sol ou un décor.'
			status(why)
			toast(why, 'warn', 4)
			return
		end
		cancel()
		S.busy = true
		if UIS.TouchEnabled then UI.panel.Visible = false end -- libère l'écran sur mobile (ARMES le rouvre)
		local id, index = S.gen, S.selected
		local ctx = makeCtx(index, pos, hit)
		status(SYSTEMS[index].code .. ' · ' .. SYSTEMS[index].name .. ' en cours… (X annule)')
		refreshUI()
		task.spawn(function()
			local ok, err = xpcall(runAttack, debug.traceback, id, index, ctx)
			if active(id) then
				filmEnd()
				countdownHide()
				S.busy = false
				S.cover, S.press = 0, 0
				if ok then
					status(SYSTEMS[index].note)
				else
					clearEffects()
					status('Erreur : le message est affiché en haut de l’écran.')
					reportError(err)
				end
				refreshUI()
			end
		end)
	end
	local function skipFilm()
		if film then
			film.skip = true
			filmEnd()
		end
	end

	-- MENU ---------------------------------------------------------------------------------------
	refreshUI = function()
		if S.dead then return end
		for i, b in ipairs(UI.skills) do
			b.BackgroundColor3 = (i == S.selected) and SYSTEMS[i].color:Lerp(C(14, 18, 30), .62) or C(26, 33, 52)
		end
		UI.films.Text = S.films and 'FILMS : OUI' or 'FILMS : NON'
		UI.speed.Text = 'VITESSE ×' .. string.format('%g', S.speed)
		UI.size.Text = 'TAILLE ×' .. string.format('%g', S.size)
		UI.fire.Text = S.busy and 'EN COURS… (ANNULER)' or 'LANCER  (F)'
		UI.dockLabel.Text = SYSTEMS[S.selected].code .. ' · ' .. SYSTEMS[S.selected].name .. (S.busy and ' · EN COURS' or '')
		UI.shoot.Text = S.busy and 'ANNULER' or 'TIRER'
		UI.equip.Text = equipped() and 'RANGER' or 'ÉQUIPER'
	end
	local function selectSkill(i)
		if S.busy then return end
		S.selected = i
		status(SYSTEMS[i].note)
		refreshUI()
	end
	local function toggleFilms()
		if S.busy then return end
		S.films = not S.films
		status(S.films and 'Films plein écran : OUI' or 'Films : NON (compte à rebours affiché à l’écran)')
		refreshUI()
	end
	local function togglePanel()
		if film then return end
		UI.panel.Visible = not UI.panel.Visible
	end
	local function layout()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp, touch = cam.ViewportSize, UIS.TouchEnabled
		UI.dock.Visible = touch
		-- hauteur utile (sous la barre Roblox) ; sur mobile le menu s'arrête au-dessus des boutons du bas
		local usable = hudGui.AbsoluteSize.Y > 0 and hudGui.AbsoluteSize.Y or vp.Y
		local h = touch and (usable - 12 - 172) or (usable - 24)
		UI.panel.Size = UDim2.fromOffset(math.min(300, vp.X - 24), math.max(120, math.min(288 + #SYSTEMS * 52, h)))
		UI.panel.AnchorPoint = touch and Vector2.new(.5, 0) or Vector2.new(1, 0)
		UI.panel.Position = touch and UDim2.new(.5, 0, 0, 12) or UDim2.new(1, -12, 0, 12)
	end
	local function shutdown()
		if S.dead then return end
		cancel()
		S.dead = true
		giveEpoch = giveEpoch + 1
		pcall(function() RunService:UnbindFromRenderStep('ShootingStarShakeUndo') end)
		pcall(function() RunService:UnbindFromRenderStep('ShootingStarShake') end)
		pcall(function() RunService:UnbindFromRenderStep('ShootingStarFilmCamera') end)
		removeTool()
		for _, c in ipairs(connections) do c:Disconnect() end
		Screen.leave()
		FX.destroy()
		root:Destroy()
		hudGui:Destroy()
		fxGui:Destroy()
		cineGui:Destroy()
		ctrlGui:Destroy()
	end

	for i, b in ipairs(UI.skills) do connect(b.Activated, function() selectSkill(i) end) end
	connect(UI.films.Activated, toggleFilms)
	do -- VITESSE et TAILLE avancent d'un cran à chaque clic (curseurs du mod : 0.3× à 3×)
		local SPEEDS, SIZES = {.3, .5, .75, 1, 1.5, 2, 3}, {.5, .75, 1, 1.5, 2}
		local function nextStep(list, value)
			for _, v in ipairs(list) do
				if v > value + 1e-3 then return v end
			end
			return list[1]
		end
		connect(UI.speed.Activated, function()
			if S.busy then return end
			S.speed = nextStep(SPEEDS, S.speed)
			refreshUI()
		end)
		connect(UI.size.Activated, function()
			if S.busy then return end
			S.size = nextStep(SIZES, S.size)
			refreshUI()
		end)
	end
	connect(UI.fire.Activated, function()
		if S.busy then cancel() else launch() end
	end)
	connect(UI.clear.Activated, cancel)
	connect(UI.close.Activated, shutdown)
	connect(UI.fold.Activated, togglePanel)
	connect(UI.menu.Activated, togglePanel)
	connect(UI.shoot.Activated, function()
		if S.busy then cancel() else launch() end
	end)
	connect(UI.equip.Activated, function()
		if S.busy then return end
		if equipped() then
			local backpack = player:FindFirstChildOfClass('Backpack')
			if backpack then S.tool.Parent = backpack end
		else
			equipTool()
		end
		refreshUI()
	end)
	connect(CINE.skip.Activated, skipFilm)
	connect(stopEvent.Event, shutdown)
	connect(UIS.InputBegan, function(input, processed)
		if processed or UIS:GetFocusedTextBox() then return end
		local key = input.KeyCode
		local digits = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
			Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine, Enum.KeyCode.Zero}
		for i, k in ipairs(digits) do
			if key == k then
				selectSkill(i)
				return
			end
		end
		if key == Enum.KeyCode.F then
			launch()
		elseif key == Enum.KeyCode.X then
			cancel()
		elseif key == Enum.KeyCode.J then
			if film then skipFilm() else toggleFilms() end
		elseif key == Enum.KeyCode.M then
			togglePanel()
		elseif key == Enum.KeyCode.DPadRight then
			selectSkill(S.selected % #SYSTEMS + 1)
		elseif key == Enum.KeyCode.DPadLeft then
			selectSkill((S.selected - 2) % #SYSTEMS + 1)
		end
	end)

	-- Tremblement de la caméra normale : appliqué après la caméra Roblox, retiré avant la
	-- suivante, pour ne jamais dériver l'orientation du joueur.
	local shakeBase = nil
	RunService:BindToRenderStep('ShootingStarShakeUndo', Enum.RenderPriority.Camera.Value - 1, guard(function()
		if shakeBase then
			local cam = workspace.CurrentCamera
			if cam and not film then cam.CFrame = shakeBase end
			shakeBase = nil
		end
	end))
	-- Pendant un film, la caméra voulue est réimposée en tout dernier : un script de caméra du jeu
	-- (vue du dessus, caméra fixe…) ne peut plus l'écraser.
	RunService:BindToRenderStep('ShootingStarFilmCamera', Enum.RenderPriority.Last.Value, guard(function()
		local f = film
		if not f or not f.wantCF then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
		cam.CFrame = f.wantCF
		cam.FieldOfView = f.wantFov or cam.FieldOfView
	end))
	RunService:BindToRenderStep('ShootingStarShake', Enum.RenderPriority.Camera.Value + 1, guard(function()
		if film or os.clock() > S.shakeEnd then return end
		local cam = workspace.CurrentCamera
		if not cam or cam.CameraType == Enum.CameraType.Scriptable then return end
		shakeBase = cam.CFrame
		cam.CFrame = cam.CFrame * shakeOffset()
	end))

	local lastDock = ''
	connect(RunService.RenderStepped, function(dt)
		local cam = workspace.CurrentCamera
		if not cam then return end
		local now = os.clock()
		for i = #ambient, 1, -1 do -- animations des restes (flèche, cristaux, tesseract…)
			if not pcall(ambient[i], now, dt) then table.remove(ambient, i) end
		end
		FX.step(now)
		local fl = S.flash
		local frame, other = UI.flash, CINE.flash
		if film then frame, other = CINE.flash, UI.flash end
		other.BackgroundTransparency = 1
		if fl then
			local k = (now - fl.t0) / fl.dur
			if k >= 1 then
				S.flash = nil
				frame.BackgroundTransparency = 1
			else
				frame.BackgroundColor3 = fl.color
				frame.BackgroundTransparency = 1 - fl.peak * (1 - k) ^ 2
			end
		else
			frame.BackgroundTransparency = 1
		end
		local holding = equipped()
		if film then
			if not film.remote then Remote.hide() end
		elseif holding then
			local char = player.Character
			local head = char and char:FindFirstChild('Head')
			local hand = char and (char:FindFirstChild('RightHand') or char:FindFirstChild('Right Arm'))
			local firstPerson = head == nil or (cam.CFrame.Position - head.Position).Magnitude < 1.6
			if firstPerson or not hand then
				Remote.pose(cam.CFrame * Remote.viewmodel)
			else
				Remote.pose(hand.CFrame * Remote.handhold)
			end
		else
			Remote.hide()
		end
		UI.cross.Visible = holding and film == nil
		local dockText = (holding and 'R' or 'E') .. (S.busy and '1' or '0')
		if dockText ~= lastDock then
			lastDock = dockText
			refreshUI()
		end
	end)

	connect(player.CharacterAdded, function(character)
		giveEpoch = giveEpoch + 1
		local epoch = giveEpoch
		cancel()
		removeTool()
		task.spawn(function()
			local humanoid = character:WaitForChild('Humanoid', 10)
			player:WaitForChild('Backpack', 10)
			if S.dead or epoch ~= giveEpoch or player.Character ~= character or not humanoid then return end
			giveTool()
			refreshUI()
		end)
	end)
	connect(player.CharacterRemoving, function()
		giveEpoch = giveEpoch + 1
		cancel()
		removeTool()
	end)
	connect(player.ChildAdded, function(child)
		if child:IsA('Backpack') and not S.dead then giveTool() end
	end)
	local camConn = nil
	local function watchCamera()
		if camConn then camConn:Disconnect() end
		local cam = workspace.CurrentCamera
		if cam then camConn = connect(cam:GetPropertyChangedSignal('ViewportSize'), layout) end
		layout()
	end
	connect(workspace:GetPropertyChangedSignal('CurrentCamera'), function()
		cancel()
		watchCamera()
	end)
	if typeof(script) == 'Instance' then connect(script.Destroying, shutdown) end

	watchCamera()
	giveTool()
	status(SYSTEMS[S.selected].note)
	refreshUI()
	local okBar, barOn = pcall(function() return StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack) end)
	local barNote = (okBar and barOn == false) and '  (Ce jeu masque la barre d’outils : utilise ÉQUIPER.)' or ''
	local vfxNote = VFX.count > 0 and string.format('  Pack VFX : %d/%d textures ✓', VFX.count, VFX.total)
		or (VFX.api and '  (Pack VFX absent : copie les PNG dans le dossier ShootingStarVFX.)' or '')
	toast((UIS.TouchEnabled
		and 'The Shooting Star V11 prêt ✓  Touche ÉQUIPER, puis touche l’écran là où frapper (ou TIRER).'
		or 'The Shooting Star V11 prêt ✓  Équipe la télécommande et clique (ou F). 1-9, 0 ou le menu pour choisir.') .. barNote .. vfxNote,
		'ok', 8)

end, debug.traceback)
if not booted then showError(bootError) end
