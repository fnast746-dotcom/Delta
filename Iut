		if not tween(id, .35, function(u)
			local q = skyPos:Lerp(p + V(0, 8 * sz, 0), easeIn(u))
			core.Position, sh.Position = q, q
			for k, r in ipairs(disk) do ringSet(r, q, 30 * sz * (.75 + k * .28), CFrame.Angles(.28, os.clock() * 6, .1)) end
