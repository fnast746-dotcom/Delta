			banner(id, 'SS-15 · ECLIPSE', col, ctx.strike - t, string.format('   %d %%', math.floor(k * 100)))
		end) then return end
		-- Totalité : la couronne apparaît
		cue('eclipse_corona')
		caption('Totalité : la couronne du Soleil apparaît')
		moon.Position = moonTo
		sunGlow.Transparency = 1
		local board, boardImg = AX.board(sh, 'eclipse', WHITE, SR * 5.2, SR * 5.2, {brightness = 3})
		VFX.attach(sh, 'sun_wheel', C(255, 226, 180), SR * 5, 1.6, 1, {loop = true, fps = 10})
		local streamers = {}
		local tan1 = viewDir:Cross(Vector3.yAxis).Unit
		local tan2 = tan1:Cross(viewDir).Unit
		for k = 1, Q(22, 12) do
			local a = k / Q(22, 12) * TAU + math.random() * .15
			local d = tan1 * math.cos(a) + tan2 * math.sin(a)
			local L = SR * (.6 + math.random() * 1.6) * (1 + .5 * math.abs(math.cos(a)))
			streamers[k] = line(ePos + viewDir * 8 * sz + d * SR * 1.02, ePos + viewDir * 8 * sz + d * (SR * 1.02 + L),
