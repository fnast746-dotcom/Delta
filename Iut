		local viewDir = ((p - ctx.fwd * 120 + V(0, 10, 0)) - ePos).Unit
		local SR = 23 * sz
		local sh = anchorAt(ePos)
		local sun = ball(ePos, SR * 2, C(255, 244, 214), effects, Enum.Material.Neon, 1)
