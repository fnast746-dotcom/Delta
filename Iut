		if not waitUntil(id, ctx.strike - .35 / S.speed, function()
			local t = os.clock()
			coronaFrame(ePos + viewDir * 9 * sz, SR * 1.08, 0)
			for i, s in ipairs(streamers) do s.Transparency = .35 + .3 * math.sin(t * 2 + i * 1.3) end
			if boardImg then boardImg.Rotation = t * 4 end
