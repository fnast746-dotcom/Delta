		burnText(p, 24 * sz, {'ECLIPSE', 'SS-15 · TOTALITY', 'SYZYGY'}, col, .35)
		local holder = anchorAt(p + V(0, 1, 0))
		local hl = light(holder, col, 24, 1.4)
		local function markSet(k, t) -- k : taille 0..1 de l'ombre
			local r = (3 + 4 * k) * sz
			shadow.Size = V(.12, r * 2, r * 2)
			ringSet(goldR, g + V(0, .05, 0), r, nil, .1)
			for i, s in ipairs(rays) do
				local a = i / 12 * TAU + t * .15
				local d = V(math.cos(a), 0, math.sin(a))
				local L = (i % 2 == 0 and 7 or 4) * sz * (.9 + .2 * math.sin(t * 3 + i))
				s.Size = V(s.Size.X, s.Size.Y, L)
				s.CFrame = look(g + d * (r + L / 2 + .5 * sz) + V(0, .04, 0), g + d * (r + L) + V(0, .04, 0))
			end
			for i, b in ipairs(beads) do
				local a = i / 6 * TAU - t * .3
				b.Position = g + V(math.cos(a) * r, .3, math.sin(a) * r)
				b.Transparency = math.sin(t * 5 + i * 1.7) > .3 and 0 or .8
