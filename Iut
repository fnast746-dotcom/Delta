	local Controls = {module = nil}
	function Controls.get()
		if Controls.module == nil then
			local ok, mod = pcall(function()
				local scripts = player:FindFirstChild('PlayerScripts')
				local pm = scripts and scripts:FindFirstChild('PlayerModule')
				return pm and require(pm):GetControls()
			end)
			Controls.module = (ok and mod) or false
		end
		return Controls.module or nil
	end
	local Screen = {saved = nil}
	function Screen.enter()
		if Screen.saved then return end
		local saved = {core = {}, guis = {}, touch = nil, controls = false}
		for _, item in ipairs(Enum.CoreGuiType:GetEnumItems()) do
			if item ~= Enum.CoreGuiType.All then
				local ok, on = pcall(function() return StarterGui:GetCoreGuiEnabled(item) end)
				if ok and on then
					saved.core[item] = true
					pcall(function() StarterGui:SetCoreGuiEnabled(item, false) end)
				end
			end
		end
		local ok, touch = pcall(function() return GuiService.TouchControlsEnabled end)
		if ok then
			saved.touch = touch
			pcall(function() GuiService.TouchControlsEnabled = false end)
		end
		if CONFIG.HIDE_OTHER_GUIS then
			for _, g in ipairs(pg:GetChildren()) do
				if g:IsA('ScreenGui') and g.Enabled and not OWN[g] and g.Name ~= 'TouchGui' then
					g.Enabled = false
					table.insert(saved.guis, g)
				end
			end
		end
		if CONFIG.FREEZE_CONTROLS then
			local controls = Controls.get()
			if controls then saved.controls = pcall(function() controls:Disable() end) end
		end
		Screen.saved = saved
	end
	function Screen.leave()
		local saved = Screen.saved
		if not saved then return end
		Screen.saved = nil
		for item in pairs(saved.core) do pcall(function() StarterGui:SetCoreGuiEnabled(item, true) end) end
		if saved.touch ~= nil then pcall(function() GuiService.TouchControlsEnabled = saved.touch end) end
		for _, g in ipairs(saved.guis) do
			if g.Parent then g.Enabled = true end
		end
		if saved.controls then
			local controls = Controls.get()
			if controls then pcall(function() controls:Enable() end) end
		end
	end

