			end
			AX.faceRing(lens, core.Position, math.max(.5, d * .56))
			icam(id, look(camF, core.Position), 76 - 12 * u)
		end) then return end
		for _, r in ipairs(disk) do ringKill(r) end
		ringKill(lens)
		core:Destroy()
		sh:Destroy()
		for _, rk in ipairs(rocks) do if rk.p.Parent then rk.p:Destroy() end end
		cue('bh_burst')
		flash(WHITE, .9, 1)
		FX.impact(p, col, sz * 2, {frame = C(255, 230, 200), dome = false})
		VFX.flip(p + V(0, 6, 0), 'dome', col, R * 4.5, 1.2)
		VFX.flip(p + V(0, R * .6, 0), 'black_hole', col, R * 3.2, .9, {emission = .6})
		FX.shock(p, C(255, 210, 160), R * 4, 1.4, 2.2 * sz)
		caption('Il s’effondre sur lui-même… puis tout est repoussé')
		tele('SINGULARITY COLLAPSE\nHAWKING FLASH · 10^30 W')
		local vortex = {}
		for k = 1, 3 do
			vortex[k] = ringNew(effects, Q(56, 36), (k == 1) and BLACK or col, Enum.Material.Neon, 1.6 * sz, .3, k == 1 and 0 or .3)
		end
		if not tween(id, 2.2, function(u, e)
			local t = os.clock()
			for k, r in ipairs(vortex) do
				ringSet(r, p + V(0, .3 + k * .1, 0), math.max(.5, R * (1.1 - .3 * k) * (1 - .7 * e)), CFrame.Angles(0, t * (4 + k * 2), 0))
			end
			spiral(spin.step(10 * (1 - e)))
			local a = .6 + e * 1.4
			icam(id, look(p + (ctx.right * math.cos(a) - ctx.fwd * math.sin(a)) * R * 2.4 + V(0, R * (.9 - .3 * e), 0), p), 70)
