					db.Transparency = u
					if u >= 1 then db:Destroy() end
				end)
				VFX.flip(edge, 'star', WHITE, 110 * sz, .5, {rot = 0, z = 3})
				flash(WHITE, .35, .55)
				FX.pulse({bloom = 1.4, size = 26, bright = .1}, .05, .1, .3)
