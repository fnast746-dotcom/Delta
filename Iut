		local function buildGravMachine(st, R) -- 8 pièces : 3 petites, 3 moyennes, 2 grandes
			local defs = {
				{1.32, .10, CFrame.Angles(0, 0, 0), 'grav_lock_s1'},
				{1.32, .10, CFrame.Angles(0, 0, math.rad(60)), 'grav_lock_s2'},
				{1.32, .10, CFrame.Angles(0, 0, math.rad(-60)), 'grav_lock_s3'},
				{1.68, .13, CFrame.Angles(math.rad(90), 0, 0), 'grav_lock_m1'},
				{1.68, .13, CFrame.Angles(math.rad(90), math.rad(60), 0), 'grav_lock_m2'},
				{1.68, .13, CFrame.Angles(math.rad(90), math.rad(-60), 0), 'grav_lock_m3'},
				{2.15, .17, CFrame.Angles(math.rad(25), 0, math.rad(12)), 'grav_lock_l1'},
				{2.15, .17, CFrame.Angles(math.rad(-25), math.rad(90), math.rad(-12)), 'grav_lock_l2'},
			}
			local pieces = {}
			for i, d in ipairs(defs) do
				local m = new('Model', {Name = 'GravRing' .. i}, st)
				local w = R * d[2]
				local clamps = {}
				for k = 1, 4 do clamps[k] = part(V(w * 1.6, w * 1.2, w * 1.4), CF(), C(60, 60, 70), m, Enum.Material.Metal) end
				pieces[i] = {ring = ringNew(m, Q(40, 26), C(225, 225, 235), Enum.Material.Metal, w, w * .55), clamps = clamps,
					radius = R * d[1], rot = d[3], from = CFrame.Angles(math.rad(80 * i), math.rad(40 * i), 0), sound = d[4],
					locked = false}
			end
			return pieces
		end
		local function setPiece(pc, k, spin)
			local rot = pc.from:Lerp(pc.rot, k) * CFrame.Angles(spin or 0, 0, 0)
			local radius = pc.radius * (1 + 5 * (1 - k))
			ringSet(pc.ring, Vector3.zero, radius, rot)
			for c, cl in ipairs(pc.clamps) do
				local a = (c - 1) / #pc.clamps * TAU + .4
				cl.CFrame = rot * CF(math.cos(a) * radius, 0, math.sin(a) * radius) * CFrame.Angles(0, -a, 0)
			end
		end
		local function buildEarthTiles(st, R) -- Terre en tuiles, pour l'éclater
			local tiles, n = {}, Q(48, 28)
			local golden, rng = math.pi * (3 - math.sqrt(5)), Random.new(99)
			local s = R * 3.8 / math.sqrt(n)
			for i = 0, n - 1 do
				local y = 1 - (i + .5) / n * 2
				local rr, a = math.sqrt(1 - y * y), i * golden
				local dir = V(math.cos(a) * rr, y, math.sin(a) * rr)
				local col = math.abs(y) > .82 and C(232, 238, 246) or (rng:NextNumber() < .35 and C(60, 120, 72) or C(30, 86, 170))
				local cf = look(dir * R * .9, dir * R * 2)
				local p = part(V(s, s, R * .35), cf, col, st, Enum.Material.SmoothPlastic)
				tiles[#tiles + 1] = {p = p, cf = cf, col = col, inv = col:Lerp(C(20, 30, 90), .55),
					out = look(dir * R * rng:NextNumber(2.4, 3.6), dir * R * 5) * CFrame.Angles(rng:NextNumber(-1, 1),
						rng:NextNumber(-1, 1), rng:NextNumber(-1, 1)),
					back = look(-dir * R * .9, -dir * R * 2) * CFrame.Angles(0, 0, math.pi)}
			end
			return tiles
		end
