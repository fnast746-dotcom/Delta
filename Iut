		end
		corona = ringNew(effects, Q(64, 40), GOLD, Enum.Material.Neon, 1.6 * sz, 1.6 * sz, .1)
		local camD = p - ctx.fwd * R * .6 + V(0, R * 3.2, 0)
		local function coronaFrame(cpos, radius, flat)
			local up = viewDir:Lerp(Vector3.yAxis, flat).Unit
			local right = up:Cross(math.abs(up.Y) > .95 and Vector3.xAxis or Vector3.yAxis).Unit
			ringSet(corona, cpos, radius, CFrame.fromMatrix(Vector3.zero, right, up, right:Cross(up)), .1)
