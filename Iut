		VFX.attach(holder, 'dark_smoke', C(36, 26, 34), 7 * sz, 2.5, 2, {emission = 0, t0 = .35})
		local spin = AX.spinner()
		local function spiral(ang)
			for k, arm in ipairs(arms) do
				for j, s in ipairs(arm) do
					local r = (3.6 + j * 1.35) * sz
					local a = k / 8 * TAU + j * .34 - ang
					s.CFrame = CF(g + V(math.cos(a) * r, .06, math.sin(a) * r)) * CFrame.Angles(0, -a + .9, 0)
