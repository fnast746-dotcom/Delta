	ATTACKS[4] = function(id, ctx) -- SS-05
		local p, cell, half, basis = ctx.pos, ctx.cell, ctx.half, ctx.basis
		local function Wp(x, y, z) return basis:PointToWorldSpace(V(x, y, z)) end
		if not remoteArm(id, 'star_arm', 'star_press') then return end
		if not waitUntil(id, at(ctx, 1.3)) then return end
		cue('tess_mark')
		local grid = {}
		for k = 0, 8 do
			local col, off = SPECTRUM[k % 7 + 1], (k - 4) * cell
			table.insert(grid, {p = line(Wp(-half, .3, off), Wp(half, .3, off), .32, col), k = k, col = col})
			table.insert(grid, {p = line(Wp(off, .3, -half), Wp(off, .3, half), .32, col), k = k, col = col})
		end
		-- 64 cellules : couche du dessus = vraie couleur du sol visé, puis terre, roche, profondeur
		local strata = {ctx.groundColor, C(116, 84, 58), C(104, 104, 110), C(58, 58, 66)}
		local mats = {Enum.Material.SmoothPlastic, Enum.Material.Ground, Enum.Material.Slate, Enum.Material.Basalt}
		local ores = {C(40, 40, 44), C(214, 180, 150), C(250, 210, 60), C(90, 230, 235), C(220, 40, 40)}
		local layers = LOW and {{.2, 1}, {.8, 3}} or {{.12, 1}, {.26, 2}, {.34, 3}, {.28, 4}}
		local cells = {}
		for x = 0, 7 do
			for z = 0, 7 do
				local cx, cz = (x - 3.5) * cell, (z - 3.5) * cell
				local m = new('Model', {Name = 'Cell'}, effects)
				local y = .06 -- 6 centièmes au-dessus du sol : pas de z-fighting
				for _, L in ipairs(layers) do
					local h = cell * L[1]
					part(V(cell - .05, h, cell - .05), basis * CF(cx, y - h / 2, cz), strata[L[2]], m, mats[L[2]])
					y = y - h
				end
				if not LOW and (x + z) % 2 == 0 then
					part(V(cell * .16, cell * .16, cell * .16), basis * CF(cx + cell * .45, -cell * .6, cz + cell * .2),
						ores[(x * 5 + z * 3) % #ores + 1], m, Enum.Material.SmoothPlastic)
				end
				local center = basis * CF(cx, .06 - cell / 2, cz)
				m.WorldPivot = center
				local wave = math.floor(math.max(math.abs(x - 3.5), math.abs(z - 3.5))) + 1
				local rise = (5.4 - wave) * cell * 2.1 + ((x * 7 + z * 13) % 5) * cell * .35
				table.insert(cells, {m = m, base = center, wave = wave, phase = x * .9 + z * 1.7,
					final = (center + V(0, rise, 0)) * TURNS[(x * 3 + z * 5) % 4 + 1]})
			end
		end
		local cageCF = basis * CF(0, half, 0)
		local cage = {}
		for i, e in ipairs(boxEdges(cageCF, V(half * 2, half * 2, half * 2))) do
			local col = SPECTRUM[(i - 1) % 7 + 1]
			cage[i] = {p = line(e[1], e[1], .6, col), a = e[1], b = e[2], col = col}
		end
		if not tween(id, 1.0, function(u)
			for i, c in ipairs(cage) do
				setLine(c.p, c.a, c.a:Lerp(c.b, easeOut(span(u, (i - 1) / 18, (i - 1) / 18 + .35))), .6)
			end
		end) then return end
		local function shearBanner() banner(id, 'DIMENSIONAL SHEAR INBOUND', VIOLET, ctx.strike - os.clock(), '   64 CELLS') end
		if not waitUntil(id, at(ctx, 13), shearBanner) then return end
		cue('tess_emerge')
		local holeC, holeR = p + V(0, ctx.holeH, 0), half * 1.3
		VFX.flip(holeC, 'vortex', VIOLET, 90 * ctx.size, 2.6, {z = 2})
		local holeDisc = disc(holeC, .2, .5, BLACK)
		local holeRim = ringNew(effects, Q(48, 32), CYAN, Enum.Material.Neon, 2.4, 1.6)
		local swirl = ringNew(effects, Q(40, 26), VIOLET, Enum.Material.ForceField, 4, 3)
		local function holeSet(k)
			local r = math.max(.3, holeR * k)
			holeDisc.Size = V(.5, r * 2, r * 2)
			ringSet(holeRim, holeC, r)
			ringSet(swirl, holeC - V(0, 1.5, 0), r * 1.12, CFrame.Angles(0, os.clock() * 1.3, 0))
		end
		if not tween(id, 1.2, function(u)
			holeSet(easeOut(u))
			shearBanner()
		end) then return end
		cue('tess_sky')
		local mach = tesseractNew(effects, 1.5)
		local scale = half / .765 -- une fois replié, le cube coïncide avec la cage
		local tA, tFold, dropped = at(ctx, 14.2), at(ctx, 15.6), false
		while active(id) and os.clock() < ctx.strike do
			local now = os.clock()
			local u = clamp((now - tA) / math.max(.05, ctx.strike - tA), 0, 1)
			local fold = clamp((now - tFold) / math.max(.05, ctx.strike - tFold), 0, 1)
			if fold > 0 and not dropped then
				dropped = true
				cue('tess_drop')
			end
			tesseractSet(mach, basis * CF(0, lerp(ctx.holeH, half, easeIn(u)), 0) * CFrame.Angles(0, now * .5 * (1 - fold), 0),
				scale * lerp(.75, 1, fold), now * .9, now * .6, now * .4, fold)
			holeSet(1)
			shearBanner()
			RunService.RenderStepped:Wait()
		end
		if not active(id) then return end
		countdownHide()
		for _, e in ipairs(mach.edges) do e:Destroy() end
		cue('tess_land')
		flash(WHITE, .5, .8)
		FX.impact(p, VIOLET, ctx.size * 1.6, {frame = C(232, 204, 255)})
		shake(1.9, 1.2)
		caption('La cage s’abat sur le carré')
		tele('IMPACT · 64 CELLS')
		local camS = p - ctx.fwd * half * 3.4 + ctx.right * half * 1.7 + V(0, half * 1.35, 0)
		if not tween(id, .7, function(u)
			holeSet(1 - u)
			for _, c in ipairs(cage) do c.p.Color = WHITE:Lerp(c.col, u) end
			icam(id, look(camS, p + V(0, half * .6, 0)), 66)
		end) then return end
		holeDisc:Destroy()
		ringKill(holeRim)
		ringKill(swirl)
		cue('tess_sever')
		VFX.zap(p + V(0, 3, 0), VIOLET, 22 * ctx.size, Q(10, 5))
		FX.pulse({sat = -.5, contrast = .3, blur = 5, vig = .2}, .05, .4, 1.2)
		FX.debris(p, 24, ctx.groundColor, Enum.Material.Slate, 50 * ctx.size, 2 * ctx.size)
		caption('Des fissures courent le long de la grille : le sol est tranché')
		tele('SEVERED')
		if not tween(id, .9, function(u)
			for _, gl in ipairs(grid) do
				local d = math.abs(gl.k - 4) / 4
				gl.p.Color = gl.col:Lerp(WHITE, math.sin(span(u, d * .55, d * .55 + .35) * math.pi))
			end
			icam(id, look(camS, p + V(0, half * .4, 0)), 66)
		end) then return end
		local function animateCells()
			local now = os.clock()
			for _, c in ipairs(cells) do
				if c.t0 and not c.done then
					local u = clamp((now - c.t0) / (1.6 / S.speed), 0, 1)
					c.m:PivotTo(c.base:Lerp(c.final, easeOut(u)))
					if u >= 1 then c.done = true end
				end
			end
		end
		local function pit(wave) -- le sol s'effondre en gradins, plus sombre vers le centre
			local shade = C(3, 3, 7):Lerp(C(22, 20, 32), (wave - 1) / 3)
			for _, c in ipairs(cells) do
				if c.wave == wave then part(V(cell - .1, .06, cell - .1), c.base * CF(0, cell / 2 - .03, 0), shade) end
			end
			local h, col = wave * cell, SPECTRUM[(wave * 2 - 2) % 7 + 1]
			for _, e in ipairs({{Wp(-h, .34, -h), Wp(h, .34, -h)}, {Wp(h, .34, -h), Wp(h, .34, h)},
				{Wp(h, .34, h), Wp(-h, .34, h)}, {Wp(-h, .34, h), Wp(-h, .34, -h)}}) do
				line(e[1], e[2], .45, col)
			end
		end
		local camRise = p - ctx.fwd * half * 2.8 + ctx.right * half * 1.2 + V(0, half * 3.4, 0)
		local lifted = 0
		caption('La gravité lâche : les cellules sont arrachées, du centre vers le bord')
		for wave = 1, 4 do
			cue('tess_lurch')
			for _, c in ipairs(cells) do
				if c.wave == wave then
					c.t0 = os.clock()
					lifted = lifted + 1
				end
			end
			pit(wave)
			tele(string.format('ASCENSION · %02d / 64 CELLS', lifted))
			if not tween(id, .7, function(u)
				animateCells()
				local k = (wave - 1 + u) / 4
				icam(id, look(camS:Lerp(camRise, smooth(k)), p + V(0, half * (.4 + 1.8 * k), 0)), 68)
			end) then return end
		end
		if not tween(id, 1.3, function()
			animateCells()
			icam(id, look(camRise, p + V(0, half * 2.2, 0)), 68)
		end) then return end
		for _, c in ipairs(cells) do
			c.done = true
			c.m:PivotTo(c.final)
		end
		cue('tess_fold')
		caption('La cage se replie sur elle-même')
		tele('FOLDED')
		local mid = cageCF.Position
		if not tween(id, 1.2, function(u, e)
			for _, c in ipairs(cage) do setLine(c.p, mid:Lerp(c.a, 1 - e), mid:Lerp(c.b, 1 - e), .6) end
			icam(id, look(camRise, p + V(0, half * 2, 0)), 68)
		end) then return end
		for _, c in ipairs(cage) do c.p:Destroy() end
		cue('tess_hum')
		local rest = tesseractNew(effects, .5)
		local restCF = basis * CF(0, half * 1.7, 0)
		addAmbient(function(t)
			tesseractSet(rest, restCF * CFrame.Angles(0, t * .3, 0), half * .3, t * .8, t * .5, t * .35, 0)
			if not LOW then
				for _, c in ipairs(cells) do c.m:PivotTo(c.final + V(0, math.sin(t * 1.2 + c.phase) * .7, 0)) end
			end
		end)
		caption('Un tesseract de lumière arc-en-ciel reste suspendu au-dessus du centre')
		tele('W-AXIS LOCKED · 64 / 64 CELLS')
		tween(id, 2.6, function(u, e)
			local a = .5 + e * 1.4
			icam(id, look(p + (ctx.right * math.cos(a) - ctx.fwd * math.sin(a)) * half * 2.6 + V(0, half * (1 + .8 * e), 0),
				p + V(0, half * 1.7, 0)), 66)
		end)
	end

	ATTACKS[5] = function(id, ctx) -- SS-06
