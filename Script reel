	function VFX.gui(parent, name, size, pos, dur, loop, color, alpha) -- animation 2D par-dessus les films
		local id = VFX.id[name]
		if not (id and parent) then return nil end
		local grid = VFX.FLIP[name]
		local img = new('ImageLabel', {AnchorPoint = Vector2.new(.5, .5), Position = pos or UDim2.fromScale(.5, .5),
			Size = size, BackgroundTransparency = 1, Image = id, ImageColor3 = color or WHITE, ImageTransparency = alpha or 0,
			ZIndex = 3}, parent)
		if name ~= 'hyperspeed' then new('UIAspectRatioConstraint', {AspectRatio = 1}, img) end
		if grid then
			local cell = 1024 / grid
			img.ImageRectSize = Vector2.new(cell, cell)
			local n = grid * grid
			FX.anim(dur, function(u)
				local k = loop and (math.floor(u * dur * 15) % n) or math.min(n - 1, math.floor(u * n))
				img.ImageRectOffset = Vector2.new((k % grid) * cell, math.floor(k / grid) * cell)
				if u >= 1 then img:Destroy() end
			end)
		else
			FX.anim(dur, function(u) if u >= 1 then img:Destroy() end end)
		end
		return img
	end
	function VFX.impact(pos, color, s, scorch) -- couches du pack ajoutées à chaque impact
		if VFX.count == 0 then return end
		local cold = color.B > color.R
		VFX.flip(pos + V(0, 6 * s, 0), math.random() < .5 and 'boom1' or 'boom2', WHITE, 38 * s, 1.1, {z = 2})
		VFX.flip(pos + V(0, 3 * s, 0), 'hit', color:Lerp(WHITE, .4), 34 * s, .5, {z = 3})
		VFX.flip(pos + V(0, 2 * s, 0), 'streaks', WHITE, 48 * s, .45, {z = 3})
		VFX.flip(pos + V(0, .6, 0), cold and 'ring_electric' or 'ring_fire', WHITE, 80 * s, .9, {flat = true, z = 1})
		VFX.smoke(pos + V(0, 2 * s, 0), C(105, 96, 90), 14 * s, Q(16, 12), 30 * s)
		if cold then VFX.zap(pos + V(0, 4 * s, 0), color, 14 * s, Q(8, 4)) end
		if scorch ~= false then VFX.cracks(pos, 18 * s) end
	end

	-- REPÈRES 2D PROJETÉS (halos d'étoiles, étiquettes de télémétrie) -------------------------
	local sprites = {}
	local function spriteClear()
		for _, s in ipairs(sprites) do s.gui:Destroy() end
		table.clear(sprites)
	end
	local function spritePrune(world) -- garde seulement les repères du mode demandé
		for i = #sprites, 1, -1 do
			if (sprites[i].world == true) ~= world then
				sprites[i].gui:Destroy()
				table.remove(sprites, i)
			end
		end
	end
	local function spriteFlare(pos, px, color, spikes, world, ref)
		local f = new('Frame', {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(px, px),
			BackgroundTransparency = 1, Visible = false}, CINE.sprites)
		flareFrames(f, color, spikes)
		local s = {gui = f, pos = pos, px = px, world = world, ref = ref, kind = 'flare', scale = 1}
		if spikes then
			s.ghosts = {}
			for i, gs in ipairs({{1.35, .2, color, .8}, {1.75, .1, C(130, 255, 190), .84}, {2.3, .32, C(160, 130, 255), .9}}) do
				local gf = new('Frame', {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromScale(gs[2], gs[2]),
					BackgroundColor3 = gs[3], BackgroundTransparency = 1, BorderSizePixel = 0}, f)
				new('UICorner', {CornerRadius = UDim.new(.5, 0)}, gf)
				s.ghosts[i] = {f = gf, k = gs[1], a = gs[4]}
			end
		end
		table.insert(sprites, s)
		return s
	end
	local function spriteLabel(pos, text, color, world)
		local f = new('TextLabel', {AnchorPoint = Vector2.new(0, 1), Size = UDim2.fromOffset(320, CINE.small + 6),
			BackgroundTransparency = 1, Text = text, TextColor3 = color or WHITE, TextSize = CINE.small,
			Font = Enum.Font.Code, TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = .5,
			Visible = false}, CINE.sprites)
		new('Frame', {Position = UDim2.new(0, -14, 1, -math.floor(CINE.small / 2) - 2), Size = UDim2.fromOffset(10, 1),
			BackgroundColor3 = color or WHITE, BorderSizePixel = 0}, f)
		local s = {gui = f, pos = pos, world = world, kind = 'label'}
		table.insert(sprites, s)
		return s
	end
	local function project(pos, world)
		if world then
			local cam = workspace.CurrentCamera
			if not cam then return nil end
			local p = cam:WorldToViewportPoint(pos)
			if p.Z <= 0 then return nil end
			return Vector2.new(p.X, p.Y), p.Z
		end
		local cam, size = CINE.camera, CINE.view.AbsoluteSize
		if size.X < 2 or size.Y < 2 then return nil end
		local rel = cam.CFrame:PointToObjectSpace(pos)
		if rel.Z > -.05 then return nil end
		local t = math.tan(math.rad(cam.FieldOfView) / 2)
		local x = rel.X / (-rel.Z * t * (size.X / size.Y))
		local y = rel.Y / (-rel.Z * t)
		return Vector2.new((x + 1) / 2 * size.X, (1 - y) / 2 * size.Y), -rel.Z
	end
	local function spriteUpdate()
		for _, s in ipairs(sprites) do
			local p, depth = nil, nil
			if s.pos and not s.hidden then p, depth = project(s.pos, s.world) end
			if p then
				s.gui.Visible = true
				if s.kind == 'flare' then
					local k = s.scale or 1
					if s.ref and depth then k = k * clamp(s.ref / depth, .3, 2) end
					s.gui.Position = UDim2.fromOffset(p.X, p.Y)
					s.gui.Size = UDim2.fromOffset(s.px * k, s.px * k)
					if s.ghosts then
						local cam = workspace.CurrentCamera
						local vs = (s.world and cam) and cam.ViewportSize or CINE.view.AbsoluteSize
						local dx, dy = vs.X / 2 - p.X, vs.Y / 2 - p.Y
						local near = clamp(1 - math.sqrt(dx * dx + dy * dy) / math.max(1, vs.Y), 0, 1)
						for _, gh in ipairs(s.ghosts) do
							gh.f.Position = UDim2.new(.5, dx * gh.k, .5, dy * gh.k)
							gh.f.BackgroundTransparency = 1 - (1 - gh.a) * near * math.min(1, k)
						end
					end
				else
					s.gui.Position = UDim2.fromOffset(p.X + 16, p.Y - 4)
				end
			else
				s.gui.Visible = false
			end
		end
	end

	-- SÉANCE DE FILM ---------------------------------------------------------------------------
	local function filmAlive(id) return film ~= nil and film.id == id and not film.skip and active(id) end
	local function filmTick()
		local f = film
		if not f then return end
		CINE.clock.Text = string.format('T+%05.2f   ×%s   LOCK %s', (os.clock() - f.t0) * S.speed,
			string.format('%g', S.speed), coords(f.ctx.pos))
		if f.card then
			local age = os.clock() - f.card.t0
			local a = math.min(age / .3, 1) * (1 - span(age, f.card.dur - .45, f.card.dur))
			CINE.card.TextTransparency = 1 - a
			CINE.cardSub.TextTransparency = 1 - a
			CINE.card.TextStrokeTransparency = 1 - a * .5
			if age >= f.card.dur then
				f.card = nil
				CINE.card.Text, CINE.cardSub.Text = '', ''
			end
		end
		spriteUpdate()
	end
	local function filmBegin(id, index, ctx)
		if film then filmEnd() end
		local cam = workspace.CurrentCamera
		if not cam then return nil end
		spriteClear()
		CINE.stage:ClearAllChildren()
		filmFx:ClearAllChildren()
		film = {id = id, index = index, sys = SYSTEMS[index], ctx = ctx, t0 = os.clock(), skip = false, mode = 'none',
			cam = cam, camType = cam.CameraType, camCF = cam.CFrame, camFov = cam.FieldOfView,
			camSubject = cam.CameraSubject, remote = false, card = nil, stopAt = math.huge}
		Screen.enter()
		hudGui.Enabled = false
		countdownHide()
		hudScale()
		CINE.view.Visible = false
		CINE.fade.BackgroundTransparency = 1
		CINE.flash.BackgroundTransparency = 1
		CINE.sys.Text = film.sys.code .. ' · ' .. string.upper(film.sys.name)
		CINE.sys.TextColor3 = film.sys.color
		CINE.tele.Text, CINE.caption.Text, CINE.card.Text, CINE.cardSub.Text = '', '', '', ''
		CINE.capBox.Visible = false
		cineGui.Enabled = true
		ctrlGui.Enabled = true
		cam.CameraType = Enum.CameraType.Scriptable
		return film
	end
	filmEnd = function()
		local f = film
		if not f then return end
		film = nil
		spriteClear()
		CINE.stage:ClearAllChildren()
		filmFx:ClearAllChildren()
		CINE.view.Visible = false
		cineGui.Enabled = false
		ctrlGui.Enabled = false
		local cam = workspace.CurrentCamera
		if cam then
			cam.CameraType = f.camType
			cam.CFrame = f.camCF -- la caméra Roblox repart de l'orientation d'avant le film
			cam.FieldOfView = f.camFov
			local subject = f.camSubject
			if not (subject and subject.Parent) then
				subject = player.Character and player.Character:FindFirstChildOfClass('Humanoid')
			end
			if subject then cam.CameraSubject = subject end
		end
		Screen.leave()
		if not S.dead then hudGui.Enabled = true end
		if refreshUI then refreshUI() end
	end
	local function shot(id, dur, fn) -- un plan du film ; s'arrête à la frappe ou si on passe
		local t0, d = os.clock(), math.max(.05, dur / S.speed)
		while filmAlive(id) and os.clock() < film.stopAt do
			local u = math.min((os.clock() - t0) / d, 1)
			fn(u, smooth(u))
			filmTick()
			if u >= 1 then return true end
			RunService.RenderStepped:Wait()
		end
		return false
	end
	local function camWorld(cf, fov)
		local f = film
		if not f then return end
		if f.mode ~= 'world' then
			f.mode = 'world'
			CINE.view.Visible = false
			spritePrune(true)
		end
		-- mémorisé : réimposé en dernier à chaque image si un script du jeu touche la caméra
		f.wantCF, f.wantFov = cf * shakeOffset(), clamp((fov or 70) + FX.fov, 1, 120)
		f.cam.CFrame = f.wantCF
		f.cam.FieldOfView = f.wantFov
	end
	local function camSpace(pos, target, fov, roll)
		local f = film
		if not f then return end
		if f.mode ~= 'space' then
			f.mode = 'space'
			CINE.view.Visible = true
			spritePrune(false)
			-- caméra principale garée vers le ciel : presque rien à dessiner derrière le film
			f.wantCF, f.wantFov = CF(f.ctx.pos + V(0, 3000, 0)) * CFrame.Angles(math.pi / 2, 0, 0), 70
			f.cam.CFrame = f.wantCF
		end
		local cf = look(pos, target)
		if roll then cf = cf * CFrame.Angles(0, 0, roll) end
		CINE.camera.CFrame = cf * shakeOffset()
		CINE.camera.FieldOfView = clamp(fov or 60, 1, 120)
	end
	local function icam(id, cf, fov) -- plans d'impact pilotés par l'attaque
		if filmAlive(id) then
			camWorld(cf, fov)
			filmTick()
		end
	end
	local function caption(text)
		if not film then return end
		CINE.caption.Text = text or ''
		CINE.capBox.Visible = (text or '') ~= ''
	end
	local function tele(text) if film then CINE.tele.Text = text or '' end end
	local function card(title, sub, dur)
		if not film then return end
		CINE.card.Text, CINE.cardSub.Text = title or '', sub or ''
		CINE.card.TextColor3 = film.sys.color
		CINE.card.TextTransparency, CINE.cardSub.TextTransparency = 1, 1
		film.card = title and {t0 = os.clock(), dur = (dur or 2.2) / S.speed} or nil
	end
	local function fade(alpha, color)
		if not film then return end
		CINE.fade.BackgroundColor3 = color or BLACK
		CINE.fade.BackgroundTransparency = 1 - clamp(alpha, 0, 1)
	end
	local function scene(id) -- nouvelle scène spatiale vide (nil si le film est fini/passé)
		if not filmAlive(id) then return nil end
		spritePrune(true)
		spriteClear()
		CINE.stage:ClearAllChildren()
		CINE.view.Ambient = C(34, 38, 52)
		CINE.view.LightDirection = V(-1, -.25, -.45)
		CINE.view.LightColor = C(255, 248, 235)
		if VFX then VFX.layer:ClearAllChildren() end
		return CINE.stage
	end

	-- TÉLÉCOMMANDE (Tool local + modèle visuel) ------------------------------------------------
	-- Boîtier sombre, capot de sécurité jaune et noir, gros bouton rouge, écran à bord rouge,
	-- étiquette « ARMED / DON'T PRESS » et touches 1 à 6, d'après la texture du .jar.
	local Remote = {parts = {}, shown = true, hinge = CF(.08, .125, .33),
		viewmodel = CF(.72, -.6, -1.55) * CFrame.Angles(math.rad(52), math.rad(-14), math.rad(4)),
		handhold = CF(0, -.45, -.25) * CFrame.Angles(math.rad(-70), 0, 0),
		closeup = CF(.42, -.36, -1.35) * CFrame.Angles(math.rad(58), math.rad(-20), math.rad(8))}
	Remote.model = new('Model', {Name = 'StellarRemote_Local'}, root)
	do
		local function piece(size, offset, color, material, kind, shape)
			local p = part(size, CF(), color, Remote.model, material or Enum.Material.SmoothPlastic, 1, shape)
			table.insert(Remote.parts, {p = p, offset = offset, kind = kind})
			return p
		end
		piece(V(.46, .12, 1.25), CF(), C(40, 42, 48))
		piece(V(.47, .05, 1.2), CF(0, -.06, 0), C(26, 27, 31))
		piece(V(.3, .012, .3), CF(-.03, .066, -.36), C(12, 12, 16))
		for _, e in ipairs({{V(.33, .014, .018), CF(-.03, .068, -.518)}, {V(.33, .014, .018), CF(-.03, .068, -.202)},
			{V(.018, .014, .33), CF(-.188, .068, -.36)}, {V(.018, .014, .33), CF(.128, .068, -.36)}}) do
			piece(e[1], e[2], RED, Enum.Material.Neon)
		end
		piece(V(.2, .013, .04), CF(-.03, .069, -.44), RED, Enum.Material.Neon)
		piece(V(.17, .012, .1), CF(-.11, .066, -.06), C(235, 232, 220))
		piece(V(.17, .013, .03), CF(-.11, .067, -.095), C(210, 30, 40))
		piece(V(.2, .02, .2), CF(.08, .07, .2), C(22, 22, 26))
		piece(V(.04, .14, .14), CF(.08, .085, .2) * UPRIGHT, RED, Enum.Material.Neon, 'button', Enum.PartType.Cylinder)
		piece(V(.24, .028, .26), CF(0, 0, -.13), C(240, 196, 40), Enum.Material.SmoothPlastic, 'hinge')
		for k = -1, 1 do
			piece(V(.035, .03, .24), CF(k * .075, .002, -.13) * CFrame.Angles(0, math.rad(30), 0), C(20, 20, 22),
				Enum.Material.SmoothPlastic, 'hinge')
		end
		for k = 1, 6 do piece(V(.05, .02, .05), CF(-.175 + (k - 1) * .07, .07, .5), C(200, 200, 206)) end
		piece(V(.3, .012, .03), CF(0, .066, .42), C(18, 18, 22))
		piece(V(.05, .03, .05), CF(-.06, .075, .42), C(225, 225, 230))
	end
	function Remote.pose(base)
		for _, info in ipairs(Remote.parts) do
			local cf
			if info.kind == 'hinge' then
				cf = base * Remote.hinge * CFrame.Angles(S.cover * 1.9, 0, 0) * info.offset
			elseif info.kind == 'button' then
				cf = base * CF(0, -.03 * S.press, 0) * info.offset
			else
				cf = base * info.offset
			end
			info.p.CFrame = cf
		end
		if not Remote.shown then
			Remote.shown = true
			for _, info in ipairs(Remote.parts) do info.p.Transparency = 0 end
		end
	end
	function Remote.hide()
		if Remote.shown then
			Remote.shown = false
			for _, info in ipairs(Remote.parts) do info.p.Transparency = 1 end
		end
	end
	Remote.hide()

	-- DÉCORS ET FILMS -----------------------------------------------------------------------------
	-- Dans un bloc do … end : ces fonctions ne comptent pas dans la limite Luau de 200 locales.
	local FILMS, B = {}, {} -- B : constructeurs aussi utilisés par les attaques au sol
	do
		local function buildStars(st, count, radius, seed)
			local rng = Random.new(seed or 814)
			local m, list = new('Model', {Name = 'Stars'}, st), {}
			for i = 1, count do
				local v = V(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
				if v.Magnitude < .05 then v = V(0, 1, 0) end
				local col = C(200 + rng:NextInteger(0, 55), 210 + rng:NextInteger(0, 40), 235 + rng:NextInteger(0, 20))
				list[i] = ball(v.Unit * radius * rng:NextNumber(.85, 1.1), rng:NextNumber(.9, 2.8) * radius / 900, col, m)
			end
			return m, list
		end
		local function buildEarth(st, pos, r, clouds)
			local m = new('Model', {Name = 'Earth'}, st)
			ball(pos, r * 2, C(28, 84, 168), m, Enum.Material.SmoothPlastic)
			local rng = Random.new(42)
			for _ = 1, Q(34, 18) do
				local y = rng:NextNumber(-.9, .9)
				local a = rng:NextNumber(0, TAU)
				local dir = V(math.cos(a) * math.sqrt(1 - y * y), y, math.sin(a) * math.sqrt(1 - y * y))
				local w = r * rng:NextNumber(.22, .42)
				local col = math.abs(y) > .78 and C(236, 240, 246) or (rng:NextNumber() < .3 and C(150, 128, 82) or C(58, 118, 70))
				part(V(w, w * rng:NextNumber(.5, .9), r * .06), look(pos + dir * (r * .985), pos + dir * (r * 2)), col, m,
					Enum.Material.SmoothPlastic)
			end
			if clouds then
				for _ = 1, Q(16, 8) do
					local y = rng:NextNumber(-.8, .8)
					local a = rng:NextNumber(0, TAU)
					local dir = V(math.cos(a) * math.sqrt(1 - y * y), y, math.sin(a) * math.sqrt(1 - y * y))
					local w = r * rng:NextNumber(.25, .5)
					part(V(w, w * .3, r * .03), look(pos + dir * (r * 1.02), pos + dir * (r * 2)), WHITE, m,
						Enum.Material.SmoothPlastic, .35)
				end
			end
			ball(pos, r * 2.14, C(110, 170, 255), m, Enum.Material.SmoothPlastic, .82) -- atmosphère
			return m
		end
		local function buildMoon(st, pos, r)
			local m = new('Model', {Name = 'Moon'}, st)
			ball(pos, r * 2, C(158, 158, 162), m, Enum.Material.SmoothPlastic)
			local rng = Random.new(33)
			for _ = 1, Q(9, 5) do
				local v = V(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
				if v.Magnitude < .1 then v = V(0, 1, 0) end
				local w = r * rng:NextNumber(.18, .4)
				part(V(w, w, r * .05), look(pos + v.Unit * (r * .99), pos + v.Unit * (r * 2)), C(118, 118, 124), m,
					Enum.Material.SmoothPlastic)
			end
			return m
		end
		local function buildSun(st, pos, r)
			ball(pos, r * 2, C(255, 240, 200), st)
			ball(pos, r * 3, C(255, 196, 110), st, Enum.Material.Neon, .72)
			ball(pos, r * 4.6, C(255, 170, 90), st, Enum.Material.Neon, .88)
			spriteFlare(pos, r * 12, C(255, 215, 140), true, false, 60)
		end
		local function buildBanded(st, pos, r, colors, spot)
			local m = new('Model', {Name = 'GasGiant'}, st)
			ball(pos, r * 2, colors[1], m, Enum.Material.SmoothPlastic)
			local n = Q(11, 7)
			for i = 1, n do
				local y = (-1 + (i - .5) / n * 2) * .9
				disc(pos + V(0, y * r, 0), math.sqrt(1 - y * y) * r * 2.008, r * 2 / n * .5, colors[i % #colors + 1], m,
					Enum.Material.SmoothPlastic)
			end
			if spot then -- Grande Tache rouge
				local dir = V(.55, -.32, .77).Unit
				part(V(r * .32, r * .16, r * .05), look(pos + dir * r, pos + dir * (r * 2)), C(196, 98, 72), m,
					Enum.Material.SmoothPlastic)
			end
			return m
		end
		local function buildGalaxy(st, center, radius, rot, count)
			local m = new('Model', {Name = 'Galaxy'}, st)
			local base = CF(center) * rot
			ball(center, radius * .16, C(255, 228, 170), m)
			ball(center, radius * .3, C(255, 210, 150), m, Enum.Material.Neon, .72)
			ball(center, radius * .5, C(255, 200, 150), m, Enum.Material.Neon, .9)
			local rng = Random.new(1993)
			for i = 1, count do
				local t = rng:NextNumber(.08, 1)
				local a = (i % 4) * TAU / 4 + math.log(t * 10 + 1) * 2.1 + rng:NextNumber(-.28, .28)
				local p = base:PointToWorldSpace(V(math.cos(a) * radius * t, rng:NextNumber(-.03, .03) * radius * (1.2 - t),
					math.sin(a) * radius * t))
				local warm = 1 - t
				ball(p, rng:NextNumber(.6, 1.8) * radius / 140 * (1.3 - t * .5), C(150 + 100 * warm, 170 + 60 * warm, 255 - 70 * warm),
					m, Enum.Material.Neon, rng:NextNumber(0, .45))
			end
			return m
		end
		local function buildStreaks(st, n, colA, colB, seed) -- traînées de vitesse lumière
			local rng = Random.new(seed)
			for i = 1, n do
				local a, r = rng:NextNumber(0, TAU), rng:NextNumber(5, 95)
				local z, len = rng:NextNumber(-950, 180), rng:NextNumber(30, 140)
				local x, y = math.cos(a) * r, math.sin(a) * r
				line(V(x, y, z), V(x, y, z - len), rng:NextNumber(.12, .45), (i % 3 == 0) and colA or colB, st,
					Enum.Material.Neon, rng:NextNumber(.15, .6))
			end
			if VFX then VFX.gui(VFX.layer, 'hyperspeed', UDim2.fromScale(1.5, 1.5), nil, 2.6, true, colB, .35) end
		end
		local function buildRailgun(st, L) -- canon le long de -Z ; culasse à +Z, bouche à -Z
			local m = new('Model', {Name = 'Railgun'}, st)
			local metal, dark = C(52, 56, 66), C(30, 32, 40)
			part(V(7, 7, L), CF(), metal, m, Enum.Material.Metal)
			part(V(16, 16, 24), CF(0, 0, L / 2 + 8), dark, m, Enum.Material.Metal)
			part(V(20, 4, 30), CF(0, -9, L / 2 + 8), metal, m, Enum.Material.Metal)
			local coils = Q(11, 7)
			for i = 0, coils do part(V(11, 11, 2.2), CF(0, 0, L / 2 - 6 - i * (L - 14) / coils), dark, m, Enum.Material.Metal) end
			local rails, nseg = {}, Q(14, 9)
			for side = -1, 1, 2 do
				for i = 1, nseg do
					local z0 = L / 2 - (i - 1) * L / nseg
					table.insert(rails, {p = part(V(1.3, 1.3, L / nseg * .92), CF(side * 4.3, 0, z0 - L / nseg / 2), C(60, 10, 16), m),
						k = i / nseg})
				end
			end
			for side = -1, 1, 2 do -- panneaux radiateurs
				for j = 0, 2 do
					local z = L / 2 - 12 - j * 27
					part(V(34, .5, 22), CF(side * 26, 0, z), C(34, 46, 72), m, Enum.Material.SmoothPlastic)
					line(V(side * 4, 0, z), V(side * 10, 0, z), 1.2, metal, m, Enum.Material.Metal)
					for g = -1, 1 do line(V(side * 9.5, .3, z + g * 7), V(side * 42.5, .3, z + g * 7), .25, C(90, 120, 170), m) end
				end
			end
			ring(V(0, 0, -L / 2), 6.5, RED, m, 20, .9, CFrame.Angles(math.pi / 2, 0, 0))
			for i = 0, 5 do part(V(.8, .8, .8), CF(0, 4.2, L / 2 - 4 - i * 20), RED, m) end
			return {model = m, rails = rails, muzzle = V(0, 0, -L / 2 - 2)}
		end
		local function buildAccelerator(st, center, radius, tilt) -- anneau de Jupiter (SS-03)
			local m = new('Model', {Name = 'MassDriver'}, st)
			local segs, up = Q(56, 36), tilt.UpVector
			ringSet(ringNew(m, segs, C(36, 36, 42), Enum.Material.Metal, 3.4, 2.4), center, radius, tilt)
			local inner = ringNew(m, segs, C(60, 24, 8), Enum.Material.Neon, .55, .55)
			local outer = ringNew(m, segs, C(60, 24, 8), Enum.Material.Neon, .55, .55)
			ringSet(inner, center + up * 1.35, radius - .9, tilt)
			ringSet(outer, center + up * 1.35, radius + .9, tilt)
			local glow = {}
			for i = 1, segs do
				table.insert(glow, inner.parts[i])
				table.insert(glow, outer.parts[i])
			end
			for k = 0, 7 do
				local a = k / 8 * TAU
				local pos = center + tilt:VectorToWorldSpace(V(math.cos(a) * radius, 0, math.sin(a) * radius))
				local cf = CFrame.lookAt(pos, pos + tilt:VectorToWorldSpace(V(-math.sin(a), 0, math.cos(a))), up)
				part(V(6.5, 6, 4.5), cf, C(28, 28, 33), m, Enum.Material.Metal)
				part(V(6.8, .5, 1), cf * CF(0, 3.1, 0), EMBER, m)
			end
			return {model = m, glow = glow}
		end
		local function buildNeedle(parent, len, width, seam) -- aiguille de tungstène, axe Z
			local m = new('Model', {Name = 'GungnirNeedle'}, parent)
			m.PrimaryPart = part(V(width, width, len), CF(), C(20, 22, 27), m, Enum.Material.Metal)
			local h = width / 2 + .02
			for _, c in ipairs({V(h, h, 0), V(-h, h, 0), V(h, -h, 0), V(-h, -h, 0)}) do
				part(V(width * .08, width * .08, len * .98), CF(c), seam, m)
			end
			local nb = Q(10, 6)
			for i = 1, nb do
				part(V(width * 1.04, width * 1.04, width * .12), CF(0, 0, -len / 2 + i * len / (nb + 1)), seam, m,
					Enum.Material.Neon, .2)
			end
			return m
		end
		local function buildBrane(st, nr, nrad) -- grille polaire en entonnoir (« The Brane »)
			local m = new('Model', {Name = 'Brane'}, st)
			local col, r0, r1 = C(205, 210, 222), 12, 220
			local function depth(r) return -900 / math.max(r, r0) + 900 / r1 end
			local radii = {}
			for k = 0, nr - 1 do radii[k + 1] = r0 * (r1 / r0) ^ (k / (nr - 1)) end
			for _, r in ipairs(radii) do
				ring(V(0, depth(r), 0), r, col, m, math.max(16, math.floor(r / 4)), .35, nil, Enum.Material.Neon, .35)
			end
			for j = 0, nrad - 1 do
				local a = j / nrad * TAU
				for k = 1, #radii - 1 do
					local ra, rb = radii[k], radii[k + 1]
					line(V(math.cos(a) * ra, depth(ra), math.sin(a) * ra), V(math.cos(a) * rb, depth(rb), math.sin(a) * rb), .3,
						col, m, Enum.Material.Neon, .35)
				end
			end
			return {throatY = depth(r0), throatR = r0}
		end
