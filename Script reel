				and Enum.ParticleFlipbookLayout.Grid4x4 or Enum.ParticleFlipbookLayout.None),
			FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
			Orientation = o.flat and Enum.ParticleOrientation.VelocityPerpendicular or Enum.ParticleOrientation.FacingCamera,
			Color = typeof(color) == 'ColorSequence' and color or ColorSequence.new(color or WHITE),
			LightEmission = o.emission or 1, LightInfluence = 0, Brightness = o.brightness or 2,
			Rate = o.rate or 0, Lifetime = NumberRange.new(life * .6, life),
			Speed = NumberRange.new(speed * .45, speed), SpreadAngle = o.spread or Vector2.new(180, 180),
			Acceleration = o.accel or Vector3.zero, Drag = o.drag or 2, Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-120, 120), EmissionDirection = o.dir or Enum.NormalId.Top,
			ZOffset = o.z or 0, LockedToPart = o.locked == true,
			Size = NumberSequence.new({NumberSequenceKeypoint.new(0, o.size or 2), NumberSequenceKeypoint.new(1, o.size1 or 0)}),
			Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, o.t0 or 0),
