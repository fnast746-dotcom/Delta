	function FX.impact(pos, color, scale, o) -- impact complet : image, lueur, feu, étincelles, fumée, onde, éclats
		o = o or {}
		local s = scale or 1
		FX.impactFrame(o.frame or color)
		FX.pulse({bloom = 1.6, size = 22, bright = .26, contrast = .18, blur = 12, sat = .15, rays = .25, fov = 7, vig = .25},
			.03, .08, .95)
		FX.lightFlash(pos + V(0, 6 * s, 0), color, 16, 1.6)
		if VFX and VFX.on then -- pack : seulement ses textures (plus les éclats 3D et la lumière)
			VFX.impact(pos, color, s, o.scorch)
			if o.debris ~= false then
				FX.debris(pos, 18, o.debrisColor or C(72, 66, 60), Enum.Material.Slate, 70 * s, 1.6 * s, o.hot)
			end
			shake(1.4 * s, 1.2)
			return
		end
		FX.burst(pos + V(0, 2 * s, 0), 'fire', 26, ColorSequence.new(WHITE, color), {life = .9, speed = 30 * s,
			size = 10 * s, size1 = 2 * s, drag = 4, accel = V(0, 12, 0), brightness = 3})
		FX.burst(pos + V(0, 1, 0), 'spark', 70, color, {life = 1.5, speed = 80 * s, size = 1 * s, drag = 1.1,
			accel = V(0, -45, 0), brightness = 5})
		FX.burst(pos + V(0, 1.5 * s, 0), 'smoke', 28, C(74, 66, 62), {life = 2.8, speed = 24 * s, size = 10 * s,
			size1 = 20 * s, drag = 2.4, emission = 0, t0 = .35, tm = .62, accel = V(0, 3, 0)})
		FX.shock(pos, color, 48 * s, .95, 1.4 * s)
		if o.dome ~= false then FX.dome(pos, color, 22 * s, .6) end
		if o.debris ~= false then
			FX.debris(pos, 18, o.debrisColor or C(72, 66, 60), Enum.Material.Slate, 70 * s, 1.6 * s, o.hot)
		end
		if o.scorch ~= false then FX.scorch(pos, 14 * s, color) end
		if VFX then VFX.impact(pos, color, s, o.scorch) end
		shake(1.4 * s, 1.2)
	end
	function FX.clear() -- annulation : tout s'arrête (les pièces sont détruites avec le dossier effects)
		table.clear(FX.anims)
		table.clear(FX.pulses)
		FX.grade, FX.fov = nil, 0
		FX.ifr.BackgroundTransparency = 1
		if VFX and VFX.layer then VFX.layer:ClearAllChildren() end
	end
	function FX.destroy()
		FX.clear()
		if FX.post then
			for _, e in pairs(FX.post) do pcall(function() e:Destroy() end) end
			FX.post = nil
		end
	end
	function FX.step(now) -- chaque image : animations, étalonnage + impulsions, vignette
		for i = #FX.anims, 1, -1 do
			local a = FX.anims[i]
			local u = math.min((now - a.t0) / a.dur, 1)
			local ok = pcall(a.fn, u, now)
			if u >= 1 or not ok then table.remove(FX.anims, i) end
		end
		local g = FX.grade
		local bloom, size, bright, contrast, sat, blur, rays, fov, vig = 0, 24, 0, 0, 0, 0, 0, 0, 0
		local tint = Color3.new(1, 1, 1)
		local busy = g ~= nil
		if g then
			bloom, size, contrast, sat, rays = g.bloom or .5, g.size or 26, g.contrast or 0, g.sat or 0, g.rays or 0
			tint, vig = g.tint or tint, .16
		end
		for i = #FX.pulses, 1, -1 do
			local p = FX.pulses[i]
			local age = now - p.t0
			local k = 1
			if age < p.up then
				k = age / p.up
			elseif age > p.up + p.hold then
				k = 1 - (age - p.up - p.hold) / p.down
			end
			if k <= 0 and age > p.up then
				table.remove(FX.pulses, i)
			else
				k = clamp(k, 0, 1)
				busy = true
				bloom = bloom + (p.bloom or 0) * k
				size = size + (p.size or 0) * k
				bright = bright + (p.bright or 0) * k
				contrast = contrast + (p.contrast or 0) * k
				sat = sat + (p.sat or 0) * k
				blur = blur + (p.blur or 0) * k
				rays = rays + (p.rays or 0) * k
				fov = fov + (p.fov or 0) * k
				vig = vig + (p.vig or 0) * k
				if p.tint then tint = tint:Lerp(p.tint, k) end
			end
		end
		FX.fov = fov
		local P = FX.post
		if busy then
			P = FX.ensure()
			if P then
				P.bloom.Enabled, P.cc.Enabled = true, true
				P.blur.Enabled, P.rays.Enabled = blur > .05, rays > .01
				P.bloom.Intensity = math.min(bloom, 3)
				P.bloom.Size = clamp(size, 8, 56)
				P.cc.Brightness = clamp(bright, -.6, .6)
				P.cc.Contrast = clamp(contrast, -.5, .8)
				P.cc.Saturation = clamp(sat, -1, 1)
				P.cc.TintColor = tint
				P.blur.Size = math.min(blur, 24)
				P.rays.Intensity = math.min(rays, .5)
			end
		elseif P then
			for _, e in pairs(P) do
				if e.Parent then e.Enabled = false end
			end
		end
		if film then vig = vig + .38 end
		local vt = 1 - clamp(vig, 0, .85)
		for _, list in ipairs(FX.vigs) do
			for _, f in ipairs(list) do f.BackgroundTransparency = vt end
		end
	end

	-- PACK VFX (V7) ------------------------------------------------------------------------------
	-- Textures PNG chargées depuis le dossier de l'exécuteur (Delta…) avec getcustomasset, AJOUTÉES
	-- par-dessus les effets de la V5 : rien n'est remplacé. Sans le pack, le script reste la V5.
	VFX = {dir = 'ShootingStarVFX', id = {}, count = 0, total = 0, api = false,
		FLIP = {boom1 = 4, boom2 = 4, hit = 4, streaks = 4, ring_fire = 4, ring_electric = 4, sun_wheel = 4,
			vortex = 4, magma = 4, fire_wall = 4, hyperspeed = 4, star = 4, orb = 8},
		STATIC = {'halo', 'smoke1', 'smoke2', 'beam', 'lightning', 'cracks', 'trail'}}
	do
		local gca = getcustomasset or getsynasset
		local isf = isfile
		local list = {}
		for name in pairs(VFX.FLIP) do list[#list + 1] = name end
		for _, name in ipairs(VFX.STATIC) do list[#list + 1] = name end
		VFX.total = #list
		VFX.api = gca ~= nil and isf ~= nil
		pcall(function() -- crée le dossier à remplir (on le retrouve par son nom dans les fichiers du téléphone)
			if makefolder and not (isfolder and isfolder(VFX.dir)) then makefolder(VFX.dir) end
			if writefile and not isf(VFX.dir .. '/LISEZMOI.txt') then
				writefile(VFX.dir .. '/LISEZMOI.txt', 'Copie ici les PNG du pack ShootingStarVFX (boom1.png, halo.png, ...), puis relance le script.')
			end
		end)
		if VFX.api then
			for _, name in ipairs(list) do
				local path = VFX.dir .. '/' .. name .. '.png'
				local ok, id = pcall(function() return isf(path) and gca(path) or nil end)
				if ok and type(id) == 'string' and id ~= '' then
					VFX.id[name] = id
					VFX.count = VFX.count + 1
				end
			end
		end
	end
	VFX.on = VFX.count > 0
	VFX.EMBED = {
		ray_v = '',
		ray_glow = 'iVBORw0KGgoAAAANSUhEUgAAAEAAAAAICAYAAABJYvnfAAAAbUlEQVR42u3QOQoCURQF0dOOOGGokftfl5GG4oTjN7lC01vof6Go8PGqKaXorGn5zyAMwwhjTDDFLMzDEquOF/EaG+ywza0D9jjihAuu8bnjW7iHB5544Y1P+IbSQsvkqV6vBqgBaoAaoAbo836Q6R4NNHe7dwAAAABJRU5ErkJggg==',
		trail_v = '',
	}
	do
		local gca = getcustomasset or getsynasset
		if VFX.on and gca and writefile then
			local A, V64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/', {}
			for i = 1, 64 do V64[string.byte(A, i)] = i - 1 end
			local function unb64(str)
				local out, n = {}, 0
				for i = 1, #str - 3, 4 do
					local a, b, c, d = string.byte(str, i, i + 3)
					local v = V64[a] * 262144 + V64[b] * 4096 + (V64[c] or 0) * 64 + (V64[d] or 0)
					local b1, b2, b3 = math.floor(v / 65536), math.floor(v / 256) % 256, v % 256
					n = n + 1
					if c == 61 then
						out[n] = string.char(b1)
					elseif d == 61 then
						out[n] = string.char(b1, b2)
					else
						out[n] = string.char(b1, b2, b3)
					end
				end
				return table.concat(out)
			end
			for name, data in pairs(VFX.EMBED) do
				pcall(function()
					local path = VFX.dir .. '/' .. name .. '.png'
					writefile(path, unb64(data))
					local id = gca(path)
					if type(id) == 'string' and id ~= '' then VFX.id[name] = id end
				end)
			end
		end
	end
	VFX.layer = new('Frame', {Name = 'VFXLayer', Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3,
		Active = false}, CINE.view)
	function VFX.flip(pos, name, color, size, life, o) -- une animation du pack, jouée une fois
		local id = VFX.id[name]
		if not id then return nil end
		o = o or {}
		o.tex, o.grid, o.life = id, VFX.FLIP[name], life
		o.size, o.size1 = o.size0 or size * .85, size
		o.speed = o.flat and .05 or (o.speed or 0)
		o.spread, o.drag = o.spread or Vector2.new(0, 0), o.drag or 0
		o.t0, o.tm, o.brightness = o.t0 or 0, o.tm or .05, o.brightness or 2
		return FX.burst(pos, 'spark', o.count or 1, color or WHITE, o)
	end
	function VFX.attach(holder, name, color, size, life, rate, o) -- animation du pack qui suit un objet
		local id = VFX.id[name]
		if not id then return nil end
		o = o or {}
		return FX.emitter(holder, 'spark', color or WHITE, {tex = id, grid = VFX.FLIP[name], rate = rate or 2, life = life,
			speed = 0, size = size * .85, size1 = size, locked = true, t0 = o.t0 or .1, tm = o.tm or .2,
			brightness = o.brightness or 2, drag = 0, spread = Vector2.new(0, 0)})
	end
	function VFX.smoke(pos, color, size, n, power) -- bouffées de fumée et de poussière réalistes
		for k = 1, 2 do
			local id = VFX.id['smoke' .. k]
