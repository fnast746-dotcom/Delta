	function VFX.skin(b, speed, len) -- rayon d'énergie du pack (vague dans le sens du rayon) + lueur
		if b and VFX.id.ray_v then
			b.Texture, b.TextureMode, b.TextureSpeed, b.TextureLength = VFX.id.ray_v, Enum.TextureMode.Wrap, speed or 2, len or 3
			if VFX.id.ray_glow and b.Attachment0 then
				new('Beam', {Attachment0 = b.Attachment0, Attachment1 = b.Attachment1, Color = b.Color, Texture = VFX.id.ray_glow,
					TextureMode = Enum.TextureMode.Wrap, TextureLength = 50, LightEmission = 1, LightInfluence = 0, Brightness = 2,
					FaceCamera = true, Segments = 1, Width0 = b.Width0 * 1.6, Width1 = b.Width1 * 1.6,
					Transparency = NumberSequence.new(.35)}, b)
			end
		end
		return b
