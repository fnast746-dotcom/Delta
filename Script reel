	-- VISÉE ET CONTEXTE ------------------------------------------------------------------------
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local function refreshFilter()
		local list = {root}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then table.insert(list, plr.Character) end
		end
		rayParams.FilterDescendantsInstances = list
	end
	local function groundAt(pos, up, down)
		refreshFilter()
		local hit = workspace:Raycast(pos + V(0, up, 0), V(0, -(up + down), 0), rayParams)
		return hit and hit.Position or pos, hit
	end
	local function groundColor(hit)
		local fallback = C(96, 140, 72)
		local inst = hit and hit.Instance
		if inst and inst:IsA('Terrain') then
			local ok, col = pcall(function() return inst:GetMaterialColor(hit.Material) end)
			return ok and col or fallback
		elseif inst and inst:IsA('BasePart') then
			return inst.Color
		end
		return fallback
	end
	local function aim(fromRay) -- fromRay : rayon d'un toucher/clic ; sinon le + au centre
		local cam = workspace.CurrentCamera
		if not cam then return nil end
		refreshFilter()
		local vp = cam.ViewportSize
		local ray = fromRay or cam:ViewportPointToRay(vp.X / 2, vp.Y / 2) -- même centre que le viseur
		local hit = workspace:Raycast(ray.Origin, ray.Direction.Unit * 2500, rayParams)
		if hit then return hit.Position, hit end
		-- Visée vers le ciel : on cherche le sol 250 studs devant.
		local flat = V(ray.Direction.X, 0, ray.Direction.Z)
		if flat.Magnitude < 1e-3 then flat = V(0, 0, -1) end
		local probe = ray.Origin + flat.Unit * 250
		local down = workspace:Raycast(probe + V(0, 400, 0), V(0, -2000, 0), rayParams)
		if down then return down.Position, down end
		return nil
	end
	local function makeCtx(index, pos, hit)
		local cam = workspace.CurrentCamera
		local lv = cam and cam.CFrame.LookVector or V(0, 0, -1)
		local fwd = V(lv.X, 0, lv.Z)
		if fwd.Magnitude < 1e-3 then fwd = V(0, 0, -1) end
		fwd = fwd.Unit
		local right = fwd:Cross(Vector3.yAxis)
		local size = S.size
		local ctx = {index = index, pos = pos, fwd = fwd, right = right, size = size, origin = playerPos(), t0 = os.clock()}
		ctx.strike = ctx.t0 + SYSTEMS[index].countdown / S.speed
		ctx.R = 40 * size     -- rayon du faisceau (SS-01)
		ctx.Rs = 170 * size   -- rayon de l'onde de choc (SS-03)
		if index == 3 then
			ctx.W = 260 * size
			ctx.skyH = 380 * size + 220
			ctx.nodes, ctx.craters = {}, {}
			local chart = dipperChart()
			for i, s in ipairs(DIPPER) do
				ctx.nodes[i] = groundAt(pos + right * (chart[i].X * ctx.W) + fwd * (chart[i].Y * ctx.W), 160, 320)
				ctx.craters[i] = lerp(22, 8, (s.mag - 1.77) / (3.31 - 1.77)) * size -- plus brillante = plus large
			end
		elseif index == 4 then
			ctx.cell = 12 * size
			ctx.half = ctx.cell * 4
			ctx.holeH = ctx.half * 2 + 150 * size
			ctx.basis = CFrame.fromMatrix(pos, right, Vector3.yAxis, -fwd)
			ctx.groundColor = groundColor(hit)
		end
		return ctx
	end
	local function remoteArm(id, soundCover, soundPress) -- capot puis bouton (0,6 s)
		cue(soundCover)
		if not tween(id, .35, function(u) S.cover = easeOut(u) end) then return false end
		cue(soundPress)
		return tween(id, .25, function(u) S.press = math.sin(u * math.pi) end)
	end
	local function banner(id, label, color, rem, extra) -- compte à rebours à l'écran hors film
		if filmAlive(id) then
			UI.count.Visible = false
			return
		end
		UI.count.Visible = true
		UI.count.Text = string.format('<font color="#%s">%s</font>   T-%05.2f%s', color:ToHex(), label,
