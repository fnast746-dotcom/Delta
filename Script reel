	-- CONSTRUCTION -----------------------------------------------------------------------------
	local function new(class, props, parent)
		local o = Instance.new(class)
		if props then
			for k, v in pairs(props) do o[k] = v end
		end
		if parent then o.Parent = parent end
		return o
	end
	local function look(at, target, up) -- lookAt sans retournement quand on vise à la verticale
		local d = target - at
		if d.Magnitude < 1e-4 then return CF(at) end
		local u = up or Vector3.yAxis
		if math.abs(d.Unit:Dot(u.Unit)) > .985 then
			u = math.abs(d.Unit.Y) > .7 and Vector3.zAxis or Vector3.yAxis
		end
		return CFrame.lookAt(at, target, u)
	end
	local function part(size, cf, color, parent, material, transparency, shape)
		local p = Instance.new('Part')
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Locked = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then p.Shape = shape end
		p.Material = material or Enum.Material.Neon
		p.Color = color or WHITE
		p.Size = size
		p.CFrame = cf or CF()
		p.Transparency = transparency or 0
		p.Parent = parent or effects
		return p
	end
	local function ball(pos, d, color, parent, material, transparency)
		return part(V(d, d, d), CF(pos), color, parent, material, transparency, Enum.PartType.Ball)
	end
	local function setLine(p, a, b, w)
		p.Size = V(w, w, math.max(.02, (b - a).Magnitude))
		p.CFrame = look((a + b) / 2, b)
	end
	local function setBar(p, a, b, w, h) -- barre plate horizontale (tranchées, traces)
		p.Size = V(w, h, math.max(.02, (b - a).Magnitude))
		p.CFrame = look((a + b) / 2, b)
	end
	local function line(a, b, w, color, parent, material, transparency)
		local p = part(V(w, w, 1), CF(), color, parent, material, transparency)
		setLine(p, a, b, w)
		return p
	end
	local function cyl(a, b, d, color, parent, material, transparency) -- cylindre de a à b
		return part(V(math.max(.02, (b - a).Magnitude), d, d), look((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0),
			color, parent, material, transparency, Enum.PartType.Cylinder)
	end
	local function disc(center, d, thick, color, parent, material, transparency) -- disque horizontal
		return part(V(thick, d, d), CF(center) * UPRIGHT, color, parent, material, transparency, Enum.PartType.Cylinder)
	end
	local function column(base, height, d, color, parent, material, transparency) -- colonne verticale
		return part(V(height, d, d), CF(base + V(0, height / 2, 0)) * UPRIGHT, color, parent, material,
			transparency, Enum.PartType.Cylinder)
	end
	-- Anneau en segments, épaisseur constante (corrige le ScaleTo de la V3).
	local function ringNew(parent, segs, color, material, thick, height, transparency)
		local r = {parts = {}, segs = segs, thick = thick or .4, height = height or thick or .4}
		for i = 1, segs do r.parts[i] = part(V(.1, .1, .1), CF(), color, parent, material, transparency) end
		return r
	end
	local function ringSet(r, center, radius, rot, transparency)
		local base = CF(center) * (rot or CFrame.identity)
		local len = math.max(.05, TAU * radius / r.segs * 1.05)
		for i, p in ipairs(r.parts) do
			local a = (i - .5) / r.segs * TAU
			p.Size = V(r.thick, r.height, len)
			p.CFrame = base * CF(math.cos(a) * radius, 0, math.sin(a) * radius) * CFrame.Angles(0, -a, 0)
			if transparency then p.Transparency = clamp(transparency, 0, 1) end
		end
	end
	local function ringKill(r)
		for _, p in ipairs(r.parts) do p:Destroy() end
		table.clear(r.parts)
	end
	local function ring(center, radius, color, parent, segs, thick, rot, material, transparency)
		local r = ringNew(parent, segs or 32, color, material, thick, thick, transparency)
		ringSet(r, center, radius, rot)
		return r
	end
	local function boxEdges(cf, size) -- 12 arêtes d'une boîte
		local pts, edges = {}, {}
		for i = 0, 7 do
			pts[i] = cf:PointToWorldSpace(V(bit32.band(i, 1) == 0 and -size.X / 2 or size.X / 2,
				bit32.band(i, 2) == 0 and -size.Y / 2 or size.Y / 2, bit32.band(i, 4) == 0 and -size.Z / 2 or size.Z / 2))
		end
		for i = 0, 7 do
			for _, b in ipairs({1, 2, 4}) do
				if bit32.band(i, b) == 0 then table.insert(edges, {pts[i], pts[i + b]}) end
			end
		end
		return edges
	end
	-- Vrai tesseract 4D : 16 sommets, 32 arêtes, rotations XW/YW/ZW, perspective 4D → 3D.
	local TESS_EDGES = {}
	for i = 0, 15 do
		for k = 0, 3 do
			local j = bit32.bxor(i, bit32.lshift(1, k))
			if i < j then table.insert(TESS_EDGES, {i, j}) end
		end
	end
	local function tesseractNew(parent, width)
		local t = {edges = {}, width = width or .4}
		for n = 1, #TESS_EDGES do t.edges[n] = part(V(.1, .1, .1), CF(), SPECTRUM[(n - 1) % 7 + 1], parent) end
		return t
	end
	-- fold : 0 = hypercube, 1 = replié en simple cube (demi-côté 0.765 × scale)
	local function tesseractSet(t, cf, scale, a, b, c, fold)
		local f = fold or 0
		a, b, c = a * (1 - f), b * (1 - f), c * (1 - f)
		local ca, sa, cb, sb, cc, sc = math.cos(a), math.sin(a), math.cos(b), math.sin(b), math.cos(c), math.sin(c)
		local pts = {}
		for i = 0, 15 do
			local x = bit32.band(i, 1) == 0 and -1 or 1
			local y = bit32.band(i, 2) == 0 and -1 or 1
			local z = bit32.band(i, 4) == 0 and -1 or 1
			local w = bit32.band(i, 8) == 0 and -1 or 1
			x, w = x * ca - w * sa, x * sa + w * ca
			y, w = y * cb - w * sb, y * sb + w * cb
			z, w = z * cc - w * sc, z * sc + w * cc
			w = w * (1 - f)
			pts[i] = cf:PointToWorldSpace(V(x, y, z) * (2.6 / (3.4 - w) * scale))
		end
		for n, e in ipairs(TESS_EDGES) do setLine(t.edges[n], pts[e[1]], pts[e[2]], t.width) end
	end
