	function FX.lightFlash(pos, color, brightness, dur)
		local h = anchorAt(pos)
		local l = light(h, color, 60, brightness)
		FX.anim(dur or 1.2, function(u)
			l.Brightness = brightness * (1 - u) ^ 2
			if u >= 1 then h:Destroy() end
		end)
	end
	function FX.shock(pos, color, radius, dur, thick) -- anneau au sol + nappe lumineuse qui s'étendent
		if VFX and VFX.on then
			VFX.flip(pos + V(0, .6, 0), color.B > color.R and 'ring_electric' or 'ring_fire', WHITE, radius * 2.2, dur or .9,
				{flat = true})
			return
		end
		local th = thick or 1.2
		local r = ringNew(effects, Q(48, 28), color, Enum.Material.Neon, th, th * .45, .15)
		local glow = disc(pos + V(0, .22, 0), 1, .16, color, effects, Enum.Material.Neon, .55)
		FX.anim(dur or .9, function(u)
			local e = easeOut(u)
			ringSet(r, pos + V(0, .4, 0), math.max(.5, radius * e), nil, .15 + .85 * u)
			local d = math.max(.2, radius * 1.5 * e)
			glow.Size = V(.16, d, d)
			glow.Transparency = .55 + .45 * u
			if u >= 1 then
				ringKill(r)
				glow:Destroy()
			end
		end)
	end
	function FX.dome(pos, color, radius, dur) -- sphère de souffle qui gonfle et s'efface
		if VFX and VFX.on then return end
		local b = ball(pos, 1, color, effects, Enum.Material.Neon, .55)
		FX.anim(dur or .7, function(u)
			local d = math.max(.5, radius * 2 * easeOut(u))
			b.Size = V(d, d, d)
			b.Transparency = .55 + .45 * u
			if u >= 1 then b:Destroy() end
		end)
	end
	function FX.scorch(pos, radius, hot) -- sol noirci + fissures incandescentes qui refroidissent
		if VFX and VFX.on then
			VFX.cracks(pos, radius * 1.3)
			return
		end
		disc(pos + V(0, .06, 0), radius * 2, .1, C(24, 19, 17), effects, Enum.Material.Slate, .08)
		local rng, cracks = Random.new(), {}
		for k = 1, Q(12, 7) do
			local a = rng:NextNumber(0, TAU)
			local dir = V(math.cos(a), 0, math.sin(a))
			cracks[k] = line(pos + dir * radius * rng:NextNumber(.12, .35) + V(0, .16, 0),
				pos + dir * radius * rng:NextNumber(.75, 1.08) + V(0, .16, 0), rng:NextNumber(.22, .5), hot or EMBER)
		end
		FX.anim(8, function(u)
			local c = (hot or EMBER):Lerp(C(70, 20, 12), easeIn(u))
			for _, s in ipairs(cracks) do
				s.Color = c
				s.Transparency = .05 + .55 * u
			end
		end)
	end
	function FX.debris(pos, n, color, material, power, size, hot) -- éclats en vol balistique, rebond amorti
		local rng = Random.new()
		local char = player.Character
		FX.rp.FilterDescendantsInstances = char and {root, char} or {root}
		local list = {}
		for i = 1, math.floor(Q(n, n * .5)) do
			local s = (size or 1.4) * rng:NextNumber(.5, 1.35)
			local p = part(V(s, s * rng:NextNumber(.45, 1), s * rng:NextNumber(.6, 1.2)),
				CF(pos + V(rng:NextNumber(-2, 2), 1.2, rng:NextNumber(-2, 2))) * CFrame.Angles(rng:NextNumber(0, TAU),
				rng:NextNumber(0, TAU), 0), hot or color, effects, hot and Enum.Material.Neon or material or Enum.Material.Slate)
			local a, up = rng:NextNumber(0, TAU), rng:NextNumber(.4, 1)
			local v = V(math.cos(a) * (1.1 - up * .6), up, math.sin(a) * (1.1 - up * .6)).Unit * (power or 60) * rng:NextNumber(.45, 1.1)
			list[i] = {p = p, v = v, w = V(rng:NextNumber(-9, 9), rng:NextNumber(-9, 9), rng:NextNumber(-9, 9)), live = true}
		end
		local last = os.clock()
		FX.anim(5, function(u, now)
			local dt = math.min(now - last, .05) * S.speed
			last = now
			for _, d in ipairs(list) do
				if d.p.Parent then
					if d.live and dt > 0 then
						local from = d.p.Position
						d.v = d.v - V(0, workspace.Gravity * .55 * dt, 0)
						local to = from + d.v * dt
						local hit = workspace:Raycast(from, to - from, FX.rp)
						if hit then
							to = hit.Position + hit.Normal * d.p.Size.Y * .4
							if d.v.Magnitude > 22 then
								d.v = (d.v - 2 * d.v:Dot(hit.Normal) * hit.Normal) * .32
							else
								d.live = false
							end
						end
						d.p.CFrame = CF(to) * (d.p.CFrame - d.p.Position) * CFrame.Angles(d.w.X * dt, d.w.Y * dt, d.w.Z * dt)
					end
					if hot then d.p.Color = hot:Lerp(color, span(u, .05, .5)) end
					if u > .8 then d.p.Transparency = span(u, .8, 1) end
					if u >= 1 then d.p:Destroy() end
				end
			end
		end)
	end
	function FX.glowBeam(a0, a1, color, width, o) -- faisceau en 3 couches (cœur blanc, couleur, halo)
