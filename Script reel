	function FX.ensure()
		local cam = workspace.CurrentCamera
		if not cam then return nil end
		local P = FX.post
		if P and not P.bloom.Parent then
			for _, e in pairs(P) do pcall(function() e:Destroy() end) end
			P = nil
		end
		if not P then
			P = {bloom = new('BloomEffect', {Name = 'ShootingStarBloom', Intensity = 0, Size = 24, Threshold = 1.6}),
				cc = new('ColorCorrectionEffect', {Name = 'ShootingStarGrade'}),
				blur = new('BlurEffect', {Name = 'ShootingStarBlur', Size = 0}),
				rays = new('SunRaysEffect', {Name = 'ShootingStarRays', Intensity = 0, Spread = .8})}
			FX.post = P
		end
		for _, e in pairs(P) do
			if e.Parent ~= cam then e.Parent = cam end
		end
