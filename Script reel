	-- Projection gnomonique de la Grande Ourse (est à gauche, comme vue dans le ciel).
	local function dipperRaw()
		local d2r = math.pi / 180
		local ra0, dec0 = 12.41 * 15 * d2r, 55.8 * d2r
		local out = {}
		for i, s in ipairs(DIPPER) do
			local ra, dec = s.ra * 15 * d2r, s.dec * d2r
			local cosc = math.sin(dec0) * math.sin(dec) + math.cos(dec0) * math.cos(dec) * math.cos(ra - ra0)
			local x = math.cos(dec) * math.sin(ra - ra0) / cosc
			local y = (math.cos(dec0) * math.sin(dec) - math.sin(dec0) * math.cos(dec) * math.cos(ra - ra0)) / cosc
			out[i] = Vector2.new(-x, y)
		end
		return out
	end
	local function dipperChart() -- centrée, largeur totale = 1
		local raw = dipperRaw()
		local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
		for _, v in ipairs(raw) do
			minX, maxX = math.min(minX, v.X), math.max(maxX, v.X)
			minY, maxY = math.min(minY, v.Y), math.max(maxY, v.Y)
		end
		local cx, cy, w = (minX + maxX) / 2, (minY + maxY) / 2, math.max(maxX - minX, maxY - minY)
		local out = {}
		for i, v in ipairs(raw) do out[i] = Vector2.new((v.X - cx) / w, (v.Y - cy) / w) end
		return out
	end
	local function dipper3D(k) -- Soleil à l'origine, regard vers -Z, distances réelles × k
		local raw, out = dipperRaw(), {}
		for i, s in ipairs(DIPPER) do out[i] = V(raw[i].X, raw[i].Y, -1).Unit * (s.ly * k) end
		return out
